# Agent Runtime Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Engine Routing ───────────────────────────────────────────────
MIN_TOKEN_BUDGET=1000              # Min tokens before routing to stub engine (default: 1000)

# ─── Agent Runtime API Connection ────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:3000  # Agent Runtime API URL
