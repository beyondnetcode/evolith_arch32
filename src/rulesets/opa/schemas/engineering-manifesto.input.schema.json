{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/engineering-manifesto.input.schema.json",
  "title": "Engineering Manifesto OPA Policy Input Schema",
  "type": "object",
  "required": [
    "classLineCount",
    "classMethodCount",
    "liskovViolations",
    "domainImportsInfrastructure",
    "maxCyclomaticComplexity",
    "circularDependencies",
    "magicNumbersCount"
  ],
  "properties": {
    "classLineCount": { "type": "integer", "minimum": 0 },
    "classMethodCount": { "type": "integer", "minimum": 0 },
    "liskovViolations": { "type": "integer", "minimum": 0 },
    "domainImportsInfrastructure": { "type": "boolean" },
    "maxCyclomaticComplexity": { "type": "integer", "minimum": 0 },
    "circularDependencies": { "type": "boolean" },
    "magicNumbersCount": { "type": "integer", "minimum": 0 }
  }
}
