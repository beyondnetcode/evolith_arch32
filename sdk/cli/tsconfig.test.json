{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "baseUrl": "./src",
    "paths": {
      "domain/*": ["domain/*"],
      "infrastructure/*": ["infrastructure/*"],
      "application/*": ["application/*"],
      "core/*": ["core/*"],
      "commands/*": ["commands/*"],
      "test/*": ["test/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.test.ts", "src/**/*.spec.ts"]
}