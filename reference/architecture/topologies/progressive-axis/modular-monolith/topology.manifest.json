{
  "apiVersion": "evolith.dev/topology/v1",
  "kind": "TopologyManifest",
  "metadata": {
    "id": "modular-monolith",
    "name": "Modular Monolith",
    "dimension": "progressive-axis",
    "status": "accepted",
    "version": "1.0.0"
  },
  "spec": {
    "summary": "Canonical Evolith starting topology: one deployable system with strict bounded contexts, explicit contracts, persistence isolation, and extraction readiness.",
    "topologyType": "modular-monolith",
    "compatibility": {
      "progressiveAxis": {
        "phase": "F1",
        "profile": "modular-monolith"
      },
      "composableWith": [
        "event-driven",
        "serverless",
        "data-mesh",
        "agentic-ai"
      ]
    },
    "artifacts": {
      "adrs": [
        "reference/architecture/adrs/core/0045-microservice-extraction-readiness-criteria.md",
        "reference/architecture/adrs/core/0047-architectural-patterns-monolith-soa-microservices.md",
        "reference/architecture/adrs/core/0067-modular-monolith-schema-per-domain.md",
        "reference/architecture/adrs/core/0079-multi-topology-reference-corpus.md"
      ],
      "rulesets": [
        "rulesets/architecture/f1-modular-monolith.rules.json"
      ],
      "opaPolicies": [
        "rulesets/opa/architecture.rego"
      ],
      "aiRulesets": [
        "reference/architecture/topologies/progressive-axis/modular-monolith/README.md"
      ],
      "umsContracts": [
        "reference/knowledge/demo/ums-reference-model.md"
      ]
    },
    "operationalInterfaces": {
      "cli": {
        "validators": [
          "validate-architecture",
          "validate-topology"
        ]
      },
      "mcp": {
        "resources": [
          "evolith://topologies/modular-monolith/manifest",
          "evolith://topologies/modular-monolith/rulesets"
        ],
        "tools": [
          "evolith-topology-inspect",
          "evolith-topology-validate"
        ],
        "prompts": [
          "topology-aware-implementation",
          "extraction-readiness-review"
        ]
      },
      "coreApi": {
        "endpoints": [
          "GET /topologies/{id}",
          "GET /topologies/{id}/manifest",
          "POST /topologies/{id}/validate"
        ]
      }
    }
  },
  "businessBoundary": {
    "technicalOnly": true,
    "trackerOwns": [
      "timing",
      "ownership",
      "prioritization",
      "roi",
      "cost",
      "budget",
      "funnel-0"
    ]
  }
}
