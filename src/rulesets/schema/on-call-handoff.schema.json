{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/on-call-handoff.schema.json",
  "title": "On-Call Handoff Confirmation",
  "description": "Structured evidence that the on-call team has been briefed and is ready to support a new production release.",
  "type": "object",
  "required": ["releaseVersion", "handoffDate", "runbookReferences", "escalationPaths", "alertOwnership", "slaAcknowledgement", "confirmation"],
  "additionalProperties": false,
  "properties": {
    "releaseVersion": {
      "type": "string",
      "description": "Semantic version of the release being handed off."
    },
    "handoffDate": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date when the handoff was confirmed."
    },
    "changeSummary": {
      "type": "string",
      "minLength": 10,
      "description": "Brief summary of what changed in this release."
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Assessed risk level of the release."
    },
    "runbookReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "format": "uri" }
        }
      },
      "description": "URLs to operational runbooks relevant to this release."
    },
    "escalationPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["severity", "contact", "responseTimeMinutes"],
        "properties": {
          "severity": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "contact": { "type": "string", "minLength": 2 },
          "responseTimeMinutes": { "type": "integer", "minimum": 1 }
        }
      },
      "description": "Escalation contacts per severity level."
    },
    "alertOwnership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["alertName", "owner", "channel"],
        "properties": {
          "alertName": { "type": "string", "minLength": 3 },
          "owner": { "type": "string", "minLength": 2 },
          "channel": { "type": "string", "minLength": 2 }
        }
      },
      "description": "Who monitors which alerts and through which channel."
    },
    "slaAcknowledgement": {
      "type": "object",
      "required": ["availability", "latencyP99Ms", "errorRatePercent"],
      "properties": {
        "availability": { "type": "string", "description": "e.g. 99.9%" },
        "latencyP99Ms": { "type": "integer", "minimum": 1 },
        "errorRatePercent": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "description": "SLO targets acknowledged by the on-call team."
    },
    "confirmation": {
      "type": "object",
      "required": ["onCallLead", "role", "date"],
      "properties": {
        "onCallLead": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "date": { "type": "string", "format": "date" }
      },
      "description": "On-call lead sign-off confirming readiness."
    }
  }
}
