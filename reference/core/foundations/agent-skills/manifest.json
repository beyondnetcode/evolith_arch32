{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BMAD Skill Registry",
  "description": "Registry of composable skills available to BMAD agents in the Evolith repository",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "owner", "description", "inputs", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique identifier, lowercase kebab-case"
          },
          "name": { "type": "string", "description": "Human-readable skill name" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "owner": { "type": "string", "description": "Agent role that owns this skill" },
          "description": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of input artifacts or data sources required"
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of output artifacts produced"
          },
          "file": {
            "type": "string",
            "description": "Path to skill implementation script relative to repo root"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Searchable tags for skill discovery"
          }
        }
      }
    }
  },
  "required": ["version", "skills"],
  "skills": [
    {
      "id": "requirements-traceability-mapper",
      "name": "Requirements Traceability Mapper",
      "version": "1.0.0",
      "owner": "@analyst",
      "description": "Maps epics/stories to ADRs, governance rulesets, and test artifacts. Detects orphan requirements with no linked traceability.",
      "inputs": ["epic/story files", "ADR index", "governance rulesets"],
      "outputs": ["traceability matrix (JSON)"],
      "file": ".harness/scripts/skills/requirements-traceability-mapper.mjs",
      "tags": ["traceability", "requirements", "orphan-detection", "adr-linkage"]
    },
    {
      "id": "gap-prioritization-engine",
      "name": "Gap Prioritization Engine",
      "version": "1.0.0",
      "owner": "@po",
      "description": "Reads gap-tracking.md, calculates priority by impact × urgency, detects stagnant gaps with no status change in >30 days.",
      "inputs": ["gap-tracking.md", "gap-closure-evidence.json"],
      "outputs": ["prioritized gap report (JSON)"],
      "file": ".harness/scripts/skills/gap-prioritization-engine.mjs",
      "tags": ["gap-analysis", "prioritization", "stagnation-detection", "backlog"]
    },
    {
      "id": "adr-freshness-monitor",
      "name": "ADR Freshness Monitor",
      "version": "1.0.0",
      "owner": "@architect",
      "description": "Scans ADRs for staleness based on last git modification date. Flags >180 days as stale, >365 days as critical.",
      "inputs": ["reference/core/architecture/adrs/ directory"],
      "outputs": ["freshness report (JSON)"],
      "file": ".harness/scripts/skills/adr-freshness-monitor.mjs",
      "tags": ["adr", "freshness", "staleness", "governance"]
    },
    {
      "id": "adapter-maturity-analysis",
      "name": "Adapter Maturity Analysis",
      "version": "1.0.0",
      "owner": "@winston",
      "description": "Evaluates maturity of all InteractionAdapterPort implementations against the canonical contract. Produces structured readiness report with phantom detection.",
      "inputs": ["src/packages/agent-runtime/src/adapters/interaction/", "reference/core/foundations/agent-skills/*.md", "reference/core/foundations/agent-skills/manifest.json"],
      "outputs": ["adapter maturity report (JSON)", "phantom declarations list"],
      "file": "reference/core/foundations/agent-skills/adapter-maturity-analysis.mjs",
      "tags": ["adapter", "maturity", "interaction-adapter", "runtime", "audit", "phantom-detection"]
    },
    {
      "id": "self-improving-loop",
      "name": "Self Improving Loop",
      "version": "1.0.0",
      "owner": "@winston",
      "description": "Coordinates detect-context-execute-validate-register-learn cycles and emits progress-audit records for harness improvement runs.",
      "inputs": ["AGENTS.md", ".harness/rules/global-rules.md", ".harness/playbooks/self-improving-loop.md", "gap-tracking.md", "gap-closure-evidence.json"],
      "outputs": ["progress audit record (JSON)", "prioritized next actions", "gap or closure update recommendation"],
      "file": ".harness/scripts/skills/self-improving-loop.mjs",
      "tags": ["harness", "feedback-loop", "progress-audit", "self-improvement", "governance"]
    },
    {
      "id": "design-template-proposal",
      "name": "Design Template Proposal",
      "version": "1.0.0",
      "owner": "@architect",
      "description": "Proactively proposes reusable design templates (compositions of blocks) at simple/medium/complex tiers for a given need, conforming to design-template.schema.json (ADR-0104 §9).",
      "inputs": ["initiative context", "recommended/confirmed topology composition", "src/rulesets/schema/design-block-registry.json", "tenant private collection"],
      "outputs": ["design-template proposals (simple/medium/complex)"],
      "tags": ["design", "template", "advisory", "adr-0104", "convention-over-configuration"]
    },
    {
      "id": "template-promotion",
      "name": "Template Promotion",
      "version": "1.0.0",
      "owner": "@winston",
      "description": "Assists the governed promotion of a tenant-scope design template into the canonical Core corpus via an Upstream Proposal (UP-NNN) and Architecture Board review (ADR-0104 §9).",
      "inputs": ["tenant-scope design-template", "usage evidence", "target tier"],
      "outputs": ["upstream proposal (UP-NNN)", "promotion recommendation"],
      "tags": ["design", "template", "promotion", "upstream", "open-core", "governance"]
    }
  ]
}
