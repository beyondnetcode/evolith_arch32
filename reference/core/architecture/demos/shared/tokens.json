    "light": { "1": "0 1px 2px rgba(20,33,46,.08)", "2": "0 4px 12px rgba(20,33,46,.12)" },
    "dark": { "1": "0 1px 2px rgba(0,0,0,.4)", "2": "0 8px 24px rgba(0,0,0,.5)" }
