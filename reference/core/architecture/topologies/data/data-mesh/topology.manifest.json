        "reference/core/architecture/adrs/core/0084-data-mesh-data-products.md",
        "reference/core/architecture/adrs/core/0079-multi-topology-reference-corpus.md"
      ],
      "rulesets": [
        "reference/core/architecture/topologies/data/data-mesh/data-mesh.rules.json"
