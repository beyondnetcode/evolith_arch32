# MCP Server Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000        # Rate limit window in milliseconds (default: 60000 = 1 min)
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window per IP (default: 100)

# ─── Body Size ────────────────────────────────────────────────────
MCP_MAX_BODY_BYTES=1048576        # Max request body size in bytes (default: 1048576 = 1 MB)

# ─── HTTP Server ──────────────────────────────────────────────────
HTTP_REQUEST_TIMEOUT_MS=30000     # Request timeout in milliseconds (default: 30000 = 30s)
HTTP_KEEPALIVE_TIMEOUT_MS=65000   # Keep-alive timeout in milliseconds (default: 65000 = 65s)
MCP_HTTP_HOST=0.0.0.0             # HTTP bind address (default: 0.0.0.0)
MCP_SERVER_PORT=3000              # HTTP port (default: 3000)

# ─── Cache ────────────────────────────────────────────────────────
MCP_CACHE_TTL_MS=600000           # Cache TTL in milliseconds (default: 600000 = 10 min)
MCP_CACHE_MAX_ENTRIES=500         # Max cache entries (default: 500)

# ─── Audit ────────────────────────────────────────────────────────
AUDIT_MAX_EVENTS=1000             # Max in-memory audit events (default: 1000)
AUDIT_DEFAULT_QUERY_LIMIT=50      # Default query page size (default: 50)

# ─── API Keys ─────────────────────────────────────────────────────
API_KEY_MAX_EVENTS=1000           # Max API key events (default: 1000)
API_KEY_DEFAULT_EXPIRY_DAYS=90    # Default key expiry in days (default: 90)
API_KEY_ENTROPY_BYTES=32          # Key generation entropy (default: 32)

# ─── ABAC / OPA ──────────────────────────────────────────────────
ABAC_POLICY_CACHE_MAX=100         # Max OPA policy cache entries (default: 100)

# ─── Scaffold ─────────────────────────────────────────────────────
MCP_SCAFFOLD_TIMEOUT_MS=120000    # Scaffold command timeout (default: 120000 = 2 min)

# ─── Agent Runtime ───────────────────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:3000  # Agent Runtime URL for evolith-agent-run tool

# ─── Auth ─────────────────────────────────────────────────────────
EVOLITH_API_KEY=                  # API key for MCP authentication
JWT_SECRET=                       # JWT secret for local token validation
NODE_ENV=production               # Environment: development | production
