{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/ci-cd.input.schema.json",
  "title": "CI/CD OPA Policy Input Schema",
  "type": "object",
  "required": ["core", "satellite"],
  "properties": {
    "core": {
      "type": "object",
      "required": ["hasPackageLock", "hasDependabot"],
      "properties": {
        "hasPackageLock": { "type": "boolean" },
        "hasDependabot": { "type": "boolean" }
      }
    },
    "satellite": {
      "type": "object",
      "required": ["hasPackageLock", "workflows", "hasDependabot", "hasRenovate"],
      "properties": {
        "hasPackageLock": { "type": "boolean" },
        "workflows": { "type": "object", "additionalProperties": { "type": "string" } },
        "hasDependabot": { "type": "boolean" },
        "hasRenovate": { "type": "boolean" }
      }
    }
  }
}
