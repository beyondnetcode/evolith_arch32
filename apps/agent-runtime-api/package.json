{
  "name": "agent-runtime-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP service that exposes the Evolith Agent Runtime (deployed at evolithruntime.beyondnet.cloud)",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
