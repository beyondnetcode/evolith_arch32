{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/integration-evidence.schema.json",
  "title": "Integration Evidence",
  "description": "JSON Schema for the Integration Evidence artifact required by the RC Stamped gate (Phase 4). Demonstrates that every declared inter-component contract was exercised against a real or contract-tested counterpart.",
  "type": "object",
  "required": ["releaseCandidate", "evaluatedAt", "integrations", "result"],
  "additionalProperties": false,
  "properties": {
    "releaseCandidate": { "type": "string" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "evaluator": { "type": "string" },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "producer", "consumer", "contract", "testKind", "result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "producer": { "type": "string", "description": "Service or component emitting the contract." },
          "consumer": { "type": "string", "description": "Service or component consuming the contract." },
          "contract": { "type": "string", "description": "Reference to the contract artifact (OpenAPI, AsyncAPI, GraphQL SDL, Avro/Proto schema)." },
          "testKind": { "type": "string", "enum": ["contract", "consumer-driven", "end-to-end", "synthetic"] },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "WAIVED"] },
          "evidence": { "type": "string", "description": "Link to the run log, test report, or contract verifier output." }
        }
      }
    },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "WAIVED"] },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["integrationId", "justification", "owner", "expirationDate"],
        "additionalProperties": false,
        "properties": {
          "integrationId": { "type": "string" },
          "justification": { "type": "string" },
          "owner": { "type": "string" },
          "expirationDate": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
