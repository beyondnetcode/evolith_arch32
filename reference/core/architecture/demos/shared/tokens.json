    "authority":    { "light": ["#FBEFF3", "#E1AFC0", "#8A2A4C"], "dark": ["#2A1720", "#7A3B55", "#F0A9C3"] },
    "evidence":     { "light": ["#F2F2F2", "#BDBDBD", "#3F3F46"], "dark": ["#1C1C1E", "#4A4A50", "#C9C9D1"] }
  },
  "phase": {
    "light": ["#2F6EA5", "#1F7F72", "#4F7F1F", "#2F7F52", "#B45309"],
    "dark": ["#5B9BD5", "#3FB3A3", "#8CC24A", "#55B57C", "#E6944A"]
  },
  "maturity": {
    "visioned":    { "light": ["#F1F5F9", "#475569"], "dark": ["#1F2937", "#CBD5E1"] },
    "designed":    { "light": ["#EDE9FE", "#5B21B6"], "dark": ["#2E1F5E", "#DDD6FE"] },
    "prototyped":  { "light": ["#FEF3C7", "#92400E"], "dark": ["#3F2A08", "#FDE68A"] },
