{
  "name": "@evolith/sdk",
  "version": "0.0.1",
  "description": "Typed client library for the Evolith Core REST API and MCP tools",
  "author": "",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "generate": "echo 'No OpenAPI spec file present — types are hand-authored from the NestJS controller DTOs'",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@evolith/agent-runtime": "*",
    "@types/jest": "30.0.0",
    "@types/node": "26.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {},
  "homepage": "https://github.com/beyondnetcode/evolith_arch32#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/beyondnetcode/evolith_arch32.git",
    "directory": "src/packages/sdk-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
