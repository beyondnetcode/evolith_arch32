# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# CORS: in development '*' is automatic. In production, set explicit origins (CSV)
# or leave empty to deny cross-origin. Example:
# CORS_ORIGINS=https://tracker.beyondnet.cloud
CORS_ORIGINS=

# ─── Authentication (REQUIRED in production) ─────────────────────────────────
# Two credential types are accepted (GT-439):
#   1. Shared API key — callers send `x-api-key: <key>` or
#      `Authorization: Bearer <key>`. Service-level: acts across tenants.
#   2. Tenant JWT — callers send `Authorization: Bearer <jwt>`, HS256-verified
#      against AGENT_RUNTIME_JWT_SECRET. The verified `tenant` claim scopes the
#      principal and TenantCorpusGuard enforces per-tenant corpus isolation.
# Fail-closed: in production, if NEITHER is set, all non-public routes are denied
# unless AGENT_RUNTIME_ALLOW_NO_AUTH=true. /health, /metrics and / are public.
# NOTE: the live multi-tenant JWT issuer (JWKS/asymmetric) is gated infra; the
# HS256 shared-secret path here is the verifiable slice.
AGENT_RUNTIME_API_KEY=
AGENT_RUNTIME_JWT_SECRET=
AGENT_RUNTIME_ALLOW_NO_AUTH=false

# ─── .harness executor (optional) ────────────────────────────────────────────
# When set, the runtime executes real .harness capabilities via the process
# adapter instead of the in-memory stub. Point it at the mounted corpus.
# AGENT_RUNTIME_HARNESS_ROOT=/app/corpus/.harness
AGENT_RUNTIME_HARNESS_ROOT=
AGENT_RUNTIME_WORKSPACE_ROOT=/app/corpus

# ─── OPA policy (optional) ───────────────────────────────────────────────────
# Enable to validate via the bundled OPA binary instead of the stub.
AGENT_RUNTIME_OPA_ENABLED=false
# AGENT_RUNTIME_OPA_PATH=/app/corpus/.harness/bin/opa
# AGENT_RUNTIME_OPA_POLICY_DIR=/app/corpus/rulesets/opa
AGENT_RUNTIME_OPA_PATH=
AGENT_RUNTIME_OPA_POLICY_DIR=

# ─── Tracker trazability (optional) ──────────────────────────────────────────
# When set, trace events are POSTed to a live Evolith Tracker.
# AGENT_RUNTIME_TRACKER_ENDPOINT=https://tracker.beyondnet.cloud/api/v1/traces
AGENT_RUNTIME_TRACKER_ENDPOINT=
AGENT_RUNTIME_TRACKER_TOKEN=
