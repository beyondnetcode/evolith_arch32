{
  "name": "@evolith/smart-cli",
  "version": "1.1.0",
  "description": "Evolith Smart CLI - Governance, standards validation, and AI agent integration for satellite repositories",
  "main": "dist/main.js",
  "bin": {
    "smart-cli": "./dist/main.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsc -w & node dist/main.js",
    "build:policy": "npm run build:policy --prefix ../../",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --max-old-space-size=8192 node_modules/.bin/jest",
    "test:watch": "jest --watch",
    "test:cov": "node --max-old-space-size=4096 node_modules/.bin/jest --coverage --runInBand",
    "test:cov:unit": "node --max-old-space-size=4096 node_modules/.bin/jest --coverage --runInBand",
    "test:cov:e2e": "node --max-old-space-size=4096 node_modules/.bin/jest --config ./test/jest-e2e.json --coverage --runInBand --no-bail",
    "test:e2e": "node --max-old-space-size=4096 node_modules/.bin/jest --config ./test/jest-e2e.json --runInBand --no-bail",
    "mcp:smoke": "npm run build && node examples/mcp-test.js",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "evolith",
    "sdk",
    "cli",
    "governance",
    "standards",
    "validation",
    "adr",
    "architecture-decision-records",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "satellite-repository",
    "clean-architecture"
  ],
  "homepage": "https://github.com/beyondnetcode/evolith_arch32#readme",
  "author": "Beyondnet <dev@beyondnetcode.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/beyondnetcode/evolith_arch32.git",
    "directory": "sdk/cli"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "shell/",
    "templates/",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@evolith/core-domain": "^1.0.0",
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.26",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "conf": "^15.1.0",
    "fs-extra": "^11.3.5",
    "iconv-lite": "^0.7.2",
    "inherits": "^2.0.4",
    "nest-commander": "^3.20.1",
    "ora": "^9.4.0",
    "path-to-regexp": "^8.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@types/conf": "^2.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/yaml": "^1.9.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "debug": "^4.4.3",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "fast-json-stable-stringify": "^2.1.0",
    "jest": "^30.4.2",
    "nest-commander-testing": "^3.5.1",
    "once": "^1.4.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "wrappy": "^1.0.2"
  }
}
