{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/governance.input.schema.json",
  "title": "Governance OPA Policy Input Schema",
  "type": "object",
  "required": ["satellitePath", "corePath", "satellite"],
  "properties": {
    "satellitePath": { "type": "string" },
    "corePath": { "type": "string" },
    "satellite": {
      "type": "object",
      "required": ["directories", "files"],
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
