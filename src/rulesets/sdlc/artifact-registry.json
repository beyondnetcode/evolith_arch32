{
  "$schema": "./artifact-registry.schema.json",
  "$comment": "GT-650 / ADR-0125 — THE single artifact registry. Slug is the identity; `label` is display only and no consumer may match on it. Generated once from the two corpora it replaces and committed as the SOURCE; from here the gate files and phase-gates.rules.json derive from it.",
  "phaseVocabulary": [
    "intake",
    "discovery",
    "design",
    "construction",
    "quality",
    "deployment"
  ],
  "phaseVocabularyNote": "ADR-0125 left the phase vocabulary open. It is fixed here to the Core's own, because `DownstreamPhase` in core-domain is live code keyed on `construction|quality|deployment` and the gate corpus adds `discovery` and `design`. `intake` is declared for completeness and currently has no required artifact. A satellite whose phases are named differently (evolith_tracker uses `qa`/`release`) maps them as a written decision, exactly as it already maps artifact kinds.",
  "classificationNote": "`binding` means a gate requires it and its absence fails that gate. `advisory` means it counts towards completeness only. The nine advisory entries are advisory BECAUSE NO GATE REQUIRES THEM - that is evidence, not a default: promoting any of them would change what blocks a release, and ADR-0125 forbids doing that silently.",
  "artifacts": [
    {
      "id": "acceptance-validation",
      "label": "Acceptance Validation",
      "phases": [
        "quality"
      ],
      "classification": "binding"
    },
    {
      "id": "adr-registry",
      "label": "ADR Registry",
      "phases": [
        "design"
      ],
      "classification": "binding"
    },
    {
      "id": "architecture-drift-result",
      "label": "Architecture Drift Result",
      "phases": [
        "construction"
      ],
      "classification": "advisory"
    },
    {
      "id": "ballpark-estimation",
      "label": "Ballpark Estimation",
      "phases": [
        "discovery"
      ],
      "classification": "binding",
      "schemaId": "https://evolith.dev/schema/ballpark-estimation.schema.json"
    },
    {
      "id": "bounded-context-map",
      "label": "Bounded Context Map",
      "phases": [
        "design"
      ],
      "classification": "binding",
      "schemaId": "https://evolith.dev/schema/bounded-context-map.schema.json"
    },
    {
      "id": "build-versus-compose-analysis",
      "label": "Build-versus-Compose Analysis",
      "phases": [
        "discovery"
      ],
      "classification": "binding",
      "schemaId": "https://evolith.dev/schema/build-vs-compose.schema.json"
    },
    {
      "id": "cfr-metric",
      "label": "CFR Metric",
