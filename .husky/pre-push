set -e

# ---------------------------------------------------------------------------
# THIS HOOK USED TO PUSH SOMETHING OTHER THAN WHAT YOU ASKED IT TO.
#
# `git push -u origin my-feature-branch` ran `git push origin develop`, because the
# hook read a push INTENT recorded at commit time and never looked at the refs git
# hands it on stdin. Measured on 2026-08-16: it fired three times in one session
# against a feature branch, each time failing with `non-fast-forward` on develop —
# which is the lucky outcome. With a fast-forwardable develop it would have pushed
# it, and with `EVOLITH_PUSH_TARGET=main` it merges develop into main and pushes
# BOTH before anyone sees a prompt.
#
# For an outside contributor it is worse in a quieter way: the interactive default
# is `d) develop`, so accepting defaults records an intent to push a branch they
# cannot write to, and their first push fails with an error about somebody else's
# release process.
#
# Two rules now, and they are checked before anything runs:
#
#   1. A NON-OWNER's push is never touched. The maintainer macros below are a
#      convenience for the person who runs this project's releases; for everyone
#      else this hook is advisory and returns 0.
#   2. Even for an owner, the macro only fires when the branch being pushed is
#      `develop` or `main`. Every dispatch path operates on those two branches;
#      a feature-branch push is by definition not the release macro, so the hook
#      gets out of the way and lets git push what was typed.
#
# Rule 2 is what makes `--no-verify` unnecessary, which matters: reaching for it
# also switches off the Conventional Commits and DCO checks in commit-msg.
# ---------------------------------------------------------------------------

# `git rev-parse --git-dir` resolves both layouts: `.git` is a DIRECTORY in the
# primary checkout and a FILE holding a `gitdir:` pointer inside a worktree, where
# every hard-coded `.git/EVOLITH_*` path is ENOTDIR. Keep identical to pre-commit.
GIT_DIR_PATH="$(git rev-parse --git-dir)"

# ---------------------------------------------------------------------------
# Rule 1 — owners only. Identical detection to pre-commit.
# ---------------------------------------------------------------------------
IS_OWNER=false
OWNER_CONFIG=$(git config --global evolith.owner 2>/dev/null || echo "")
GIT_USER_EMAIL=$(git config user.email 2>/dev/null || echo "")
if [ "$OWNER_CONFIG" = "true" ] || [ "$OWNER_CONFIG" = "$GIT_USER_EMAIL" ]; then
  IS_OWNER=true
fi

if [ "$IS_OWNER" != true ]; then
  # Leave no stale intent behind, then get out of the way entirely.
  rm -f "$GIT_DIR_PATH/EVOLITH_PUSH_TARGET" \
        "$GIT_DIR_PATH/EVOLITH_CI_MODE" \
        "$GIT_DIR_PATH/EVOLITH_MERGE_METHOD"
  exit 0
fi

# ---------------------------------------------------------------------------
# Rule 2 — what is actually being pushed.
#
# git feeds pre-push one line per ref on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>
# A deletion arrives with a local ref of `(delete)`. Reading stdin consumes it,
# which is fine: nothing downstream needs it.
#
# The read is guarded because stdin can legitimately be empty (`git push` with
# nothing to do), and `set -e` must not turn that into a rejected push.
# ---------------------------------------------------------------------------
PUSHED_BRANCHES=""
while read -r local_ref _local_sha _remote_ref _remote_sha || [ -n "$local_ref" ]; do
  [ -z "$local_ref" ] && continue
  case "$local_ref" in
    refs/heads/*) PUSHED_BRANCHES="$PUSHED_BRANCHES ${local_ref#refs/heads/}" ;;
    *) : ;;   # tags, and `(delete)` for a branch deletion — never the macro
  esac
done

DISPATCHABLE=false
for b in $PUSHED_BRANCHES; do
  if [ "$b" = "develop" ] || [ "$b" = "main" ]; then
    DISPATCHABLE=true
  fi
done

TARGET=""
MERGE_METHOD="merge"

if [ -f "$GIT_DIR_PATH/EVOLITH_PUSH_TARGET" ]; then
  TARGET=$(cat "$GIT_DIR_PATH/EVOLITH_PUSH_TARGET")
fi
if [ -f "$GIT_DIR_PATH/EVOLITH_MERGE_METHOD" ]; then
  MERGE_METHOD=$(cat "$GIT_DIR_PATH/EVOLITH_MERGE_METHOD")
fi
rm -f "$GIT_DIR_PATH/EVOLITH_PUSH_TARGET" \
      "$GIT_DIR_PATH/EVOLITH_CI_MODE" \
      "$GIT_DIR_PATH/EVOLITH_MERGE_METHOD"

if [ "$DISPATCHABLE" != true ]; then
  # The common case, and the one that used to be broken. Say what was skipped and
  # why, so a surprising no-op is legible rather than mysterious.
  if [ -n "$TARGET" ] && [ "$TARGET" != "none" ]; then
    echo "Push intent was '$TARGET', but this push is:${PUSHED_BRANCHES:- (no branches)}."
    echo "Not a develop/main push — leaving it alone and skipping the release macro."
  fi
  exit 0
fi

if [ "$TARGET" = "none" ] || [ "$TARGET" = "" ]; then
  echo "No push requested. Commit only."
  exit 0
fi

# ---------------------------------------------------------------------------
# A branch another worktree has checked out cannot be checked out here.
#
# The merge dispatch below runs `git checkout "$to"`, which git refuses with
# `fatal: '<branch>' is already used by worktree at ...`. Left unchecked that
# fires AFTER repo optimization, board sync and wiki regeneration have already
# run and staged files, so the push dies half-done. Refuse up front instead,
# and name the checkout that holds the branch.
# ---------------------------------------------------------------------------
assert_checkoutable() {
  branch=$1
  holder=$(git worktree list --porcelain | awk -v b="branch refs/heads/$branch" '
    /^worktree / { wt = substr($0, 10) }
    $0 == b     { print wt; exit }')

  if [ -n "$holder" ] && [ "$holder" != "$(git rev-parse --show-toplevel)" ]; then
    echo ""
    echo "ERROR: cannot merge into '$branch' from this checkout."
    echo "  '$branch' is checked out in another worktree: $holder"
    echo ""
    echo "  Run the push from that checkout, or choose a target that does not"
    echo "  check out a branch here (EVOLITH_PUSH_TARGET=develop, or =none)."
    exit 1
  fi
}

if [ "$TARGET" = "main" ] || [ "$TARGET" = "sync" ]; then
  assert_checkoutable main
  assert_checkoutable develop
fi

echo ""
echo "Running repository optimization before push..."
node .harness/scripts/ci/02-optimize-repo.mjs

echo ""
echo "Synchronizing Gap Tracking..."
node .harness/scripts/sync-project-board.mjs

echo ""
echo "Refreshing executive governance summary..."
node .harness/scripts/generate-executive-summary.mjs

echo ""
echo "Syncing Wiki pages (if docs changed)..."
CHANGED_FILES=$(git diff --cached --name-only 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || echo "")
if echo "$CHANGED_FILES" | grep -qE '\.md$|reference/|src/rulesets/|CONTRIBUTING|AGENTS'; then
  node .harness/scripts/sync-wiki.mjs --force
  git add reference/wiki/
  echo "Wiki pages regenerated."
else
  echo "No documentation changes — wiki sync skipped."
fi

# ---------------------------------------------------------------------------
# Merge dispatch
# ---------------------------------------------------------------------------
merge_into() {
  local from=$1 to=$2 msg=$3
  git checkout "$to"
  git merge --no-ff "$from" -m "$msg"
}

squash_into() {
  local from=$1 to=$2 msg=$3
  git checkout "$to"
  git merge --squash "$from"
  git commit -m "$msg"
}

rebase_into() {
  local from=$1 to=$2 msg=$3
  git checkout "$to"
  git merge --ff-only "$from" -m "$msg"
}

dispatch_merge() {
  local from=$1 to=$2 msg=$3
  case "$MERGE_METHOD" in
    squash) squash_into "$from" "$to" "$msg" ;;
    rebase) rebase_into "$from" "$to" "$msg" ;;
    merge)  merge_into "$from" "$to" "$msg" ;;
    *)      merge_into "$from" "$to" "$msg" ;;
  esac
}

# ---------------------------------------------------------------------------
# Push by target
# ---------------------------------------------------------------------------
if [ "$TARGET" = "develop" ]; then
  echo ""
  echo "=== PUSH TO DEVELOP ==="
  git push origin develop
  echo "Pushed to develop."

elif [ "$TARGET" = "main" ]; then
  echo ""
  echo "=== PUSH TO MAIN (develop -> main) ==="
  dispatch_merge develop main "Merge develop into main"
  git push origin main
  echo ""
  echo "=== Sync main back to develop ==="
  git checkout develop
  git merge --no-ff main -m "Merge main back into develop"
  git push origin develop
  echo "Pushed to main and synced develop."

elif [ "$TARGET" = "sync" ]; then
  echo ""
  echo "=== SYNC DEVELOP <-> MAIN ==="
  echo "--- Phase 1: develop -> main ---"
  dispatch_merge develop main "Sync: develop -> main"
  git push origin main
  echo "--- Phase 2: main -> develop ---"
  git checkout develop
  git merge --no-ff main -m "Sync: main -> develop"
  git push origin develop
  echo "Develop and Main are now synchronized."

fi
