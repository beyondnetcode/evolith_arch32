{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/evaluation-context.schema.json",
  "title": "Evaluation Context",
  "description": "GT-377 / ADR-0101. What a consumer (Evolith Tracker, CLI, MCP, CI) SENDS to the stateless Core Evaluation Engine. All *Id fields are OPAQUE context identifiers (plain strings), never Core entities. Mirrors packages/core-domain/src/evaluation/contracts/evaluation-context.ts.",
  "type": "object",
  "required": ["kinds"],
  "properties": {
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["gate", "artifact", "evidence", "architecture", "blueprint", "topology", "checkpoint", "deployment", "rule", "compliance", "design"]
      }
    },
    "tenant": {
      "type": "object",
      "required": ["tenantId"],
      "properties": { "tenantId": { "type": "string" } }
    },
    "product": {
      "type": "object",
      "required": ["productId"],
      "properties": {
        "productId": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "repositoryRef": { "type": "string" }
      }
    },
    "initiative": {
      "type": "object",
      "required": ["initiativeId"],
      "properties": {
        "initiativeId": { "type": "string" },
        "productId": { "type": "string" },
        "tenantId": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "initiativeGroup": {
      "type": "object",
      "required": ["initiativeGroupId"],
      "properties": {
        "initiativeGroupId": { "type": "string" },
        "initiativeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phaseId": { "type": "string" },
    "gateId": { "type": "string" },
    "workspaceRef": { "type": "string" },
    "artifacts": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "presented": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifactId"],
            "properties": {
              "artifactId": { "type": "string" },
              "type": { "type": "string" },
              "ref": { "type": "string" },
              "schemaRef": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "evidenceType"],
        "properties": {
          "evidenceId": { "type": "string" },
          "evidenceType": { "type": "string" },
          "schemaRef": { "type": "string" },
          "producer": {
            "type": "object",
            "required": ["actorType", "actorId"],
            "properties": {
              "actorType": { "type": "string", "enum": ["human", "agent", "ci", "system"] },
              "actorId": { "type": "string" },
              "modelRef": { "type": "string" },
              "promptVersion": { "type": "string" },
              "skillVersion": { "type": "string" }
            }
          },
          "references": { "type": "array", "items": { "$ref": "#/definitions/externalReference" } },
          "integrity": {
            "type": "object",
            "required": ["contentHash"],
            "properties": {
              "contentHash": { "type": "string" },
              "capturedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpointId"],
      "properties": {
        "checkpointId": { "type": "string" },
        "phaseId": { "type": "string" },
        "status": { "type": "string" },
        "metrics": { "type": "object" }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["environment", "releaseRef"],
      "properties": {
        "environment": { "type": "string" },
        "releaseRef": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "components": { "type": "array", "items": { "type": "string" } },
        "decisionRefs": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "externalReferences": { "type": "array", "items": { "$ref": "#/definitions/externalReference" } },
    "sdlcConfig": { "type": "object" },
    "customConstraints": { "type": "object" },
    "rulesetRef": { "type": "string" },
    "rulesetVersion": { "type": "string" },
    "policyRefs": { "type": "array", "items": { "type": "string" } },
    "blueprintRef": { "type": "string" },
    "topologyRef": { "type": "string" },
    "schemaRef": { "type": "string" },
    "design": {
      "type": "object",
      "description": "Design facet (ADR-0104). Topology recommended/confirmed as a composition (mixed topologies). Read-only refs; the Core evaluates the union and never persists.",
      "properties": {
        "topologyRecommendedRefs": { "type": "array", "items": { "type": "string" } },
        "topologyConfirmedRefs": { "type": "array", "items": { "type": "string" } },
        "blueprintRef": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/definitions/designBlockRef" } },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concern"],
            "properties": {
              "concern": { "type": "string" },
              "topologies": { "type": "array", "items": { "type": "string" } },
              "runtime": { "type": "string" },
              "architecture": { "type": "string" },
              "blueprintRef": { "type": "string" },
              "blocks": { "type": "array", "items": { "$ref": "#/definitions/designBlockRef" } }
            }
          }
        },
        "artifactRefs": { "type": "array", "items": { "type": "string" } },
        "adrRefs": { "type": "array", "items": { "type": "string" } },
        "tenantCollectionRefs": { "type": "array", "items": { "type": "string" } },
        "iterationVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "executionMode": { "type": "string", "enum": ["manual", "hybrid", "agentic"] },
    "decisionHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decisionId"],
        "properties": {
          "decisionId": { "type": "string" },
          "gateId": { "type": "string" },
          "phaseId": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "WAIVE", "SKIP"] }
        }
      }
    },
    "expectedResult": { "type": "string", "enum": ["PASS", "FAIL", "WAIVE", "SKIP"] },
    "correlationId": { "type": "string" },
    "passthrough": { "type": "object" },
    "schemaVersion": { "type": "string" }
  },
  "definitions": {
    "designBlockRef": {
      "type": "object",
      "required": ["blockKind"],
      "properties": {
        "blockKind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "ref": { "type": "string" },
        "scope": { "type": "string", "enum": ["core", "tenant"] },
        "status": { "type": "string" }
      }
    },
    "externalReference": {
      "type": "object",
      "required": ["system", "kind", "externalId"],
      "properties": {
        "system": { "type": "string" },
        "kind": { "type": "string" },
        "externalId": { "type": "string" },
        "url": { "type": "string" },
        "contentHash": { "type": "string" },
        "snapshotAt": { "type": "string" }
      }
    }
  }
}
