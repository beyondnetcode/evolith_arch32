{
  "apiVersion": "evolith.dev/topology/v1",
  "kind": "TopologyManifest",
  "metadata": {
    "id": "serverless",
    "name": "Serverless",
    "dimension": "execution",
    "status": "accepted",
    "version": "1.0.0",
    "governance": {
      "owner": "Platform Engineering",
      "criticality": "P1"
    }
  },
  "spec": {
    "summary": "Managed event-scaled execution topology for isolated capabilities governed by contracts, idempotency, observability, and provider-neutral architecture rules.",
    "topologyType": "serverless",
    "compatibility": {
      "progressiveAxis": {
        "maturityLevel": "cross",
        "profile": "cross"
      },
      "composableWith": [
        "modular-monolith",
        "distributed-modules",
        "microservices",
        "event-driven",
        "data-mesh",
        "agentic-ai"
      ]
    },
    "artifacts": {
      "adrs": [
        "reference/core/architecture/adrs/core/0079-multi-topology-reference-corpus.md",
        "reference/core/architecture/adrs/core/0095-serverless-architecture-governance.md"
      ],
      "rulesets": [
        "rulesets/topologies/serverless/serverless.rules.json"
      ],
      "opaPolicies": [
        "rulesets/topologies/serverless/serverless.rego"
      ],
      "aiRulesets": [
        "rulesets/topologies/serverless/README.md"
      ],
      "umsContracts": [
        "reference/knowledge/demo/ums-reference-model.md"
      ]
    },
    "corpus": {
      "guidance": {
        "profile": "rulesets/topologies/serverless/README.md",
        "maturityGuide": "rulesets/topologies/serverless/maturity.md"
      },
      "configurationContract": "src/rulesets/topologies/serverless/topology.config.schema.json",
      "fixtures": {
        "valid": "rulesets/topologies/serverless/fixtures/valid.topology.config.json",
        "invalid": "rulesets/topologies/serverless/fixtures/invalid.topology.config.json"
      },
      "nativeEvaluator": "packages/core-domain/src/application/validators/ruleset-validator.service.ts",
      "tests": {
        "positive": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts",
        "negative": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts"
      },
      "evidence": "reference/core/control-center/maturity-evidence.json"
    },
    "operationalBudgets": {
      "latencyBudgetMs": 1500,
      "coldStartCeilingMs": 1000,
      "costCeilingPerExecutionCents": 1
    },
    "operationalInterfaces": {
      "cli": {
        "validators": [
          "validate-architecture",
          "validate-topology"
        ]
      },
      "mcp": {
        "resources": [
          "evolith://topologies/serverless/manifest",
          "evolith://topologies/serverless/rulesets"
        ],
        "tools": [
          "evolith-topology-inspect",
          "evolith-topology-validate"
        ],
        "prompts": [
          "serverless-readiness-review",
          "topology-aware-implementation"
        ]
      },
      "coreApi": {
        "endpoints": [
          "GET /topologies/{id}",
          "GET /topologies/{id}/manifest",
          "POST /topologies/{id}/validate"
        ]
      }
    },
    "designProfile": {
      "required": [
        {
          "artifactKind": "performance-plan",
          "criteria": "Cold-start and per-execution cost within operationalBudgets."
        },
        {
          "artifactKind": "infrastructure-plan",
          "criteria": "Function packaging, triggers, and concurrency limits."
        }
      ],
      "conditional": []
    },
    "phaseProfiles": {
      "quality": {
        "conditional": [
          {
            "artifactKind": "performance-validation",
            "criteria": "Cold-start/latency/cost within operational budgets."
          }
        ]
      },
      "deployment": {
        "conditional": [
          {
            "artifactKind": "runtime-budget-validation",
            "criteria": "Cold-start/cost/latency validated in the target environment."
          }
        ]
      }
    }
  },
  "businessBoundary": {
    "technicalOnly": true,
    "trackerOwns": [
      "timing",
      "ownership",
      "prioritization",
      "roi",
      "cost",
      "budget",
      "funnel-0"
    ]
  }
}
