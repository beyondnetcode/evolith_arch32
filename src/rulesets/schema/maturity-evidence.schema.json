{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/maturity-evidence.schema.json",
  "title": "Maturity Evidence",
  "description": "JSON Schema for validating maturity-evidence.json files in the Multi-Topology Reference Corpus.",
  "type": "object",
  "required": ["schemaVersion", "asOf", "checks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version version."
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the maturity status snapshot."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "observedAt", "commit", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "BLOCKED", "RESOLVED"]
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "pattern": "^(GT-\\d+|MT-A\\d+)$"
          }
        }
      }
    }
  }
}
