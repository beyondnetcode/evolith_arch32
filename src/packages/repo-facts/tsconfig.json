{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  "references": [{ "path": "../core-domain" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
