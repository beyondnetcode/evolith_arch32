{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/sdlc/sdlc-phase.schema.json",
  "title": "SDLC Phase",
  "description": "Schema for an Evolith SDLC phase data file",
  "type": "object",
  "required": ["id", "name", "shortName", "order", "description", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^f[1-5]$" },
    "name": { "type": "string" },
    "shortName": { "type": "string" },
    "order": { "type": "integer", "minimum": 1, "maximum": 5 },
    "description": { "type": "string" },
    "gates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^gate-f[1-5]$" },
      "minItems": 1
    }
  }
}
