{
  "domain": "modular-monolith",
  "description": "Modular monolith architecture rule evaluator parity — MM-R rules",
  "rules": [
    { "id": "MM-R01", "severity": "MUST", "category": "topology", "title": "Single Deployment Unit", "description": "All bounded contexts deployed as single artifact", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R02", "severity": "MUST", "category": "bounded-contexts", "title": "Explicit Bounded Context Boundaries", "description": "Each bounded context must be a separated module", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R03", "severity": "MUST", "category": "hexagonal-architecture", "title": "Ports and Adapters Boundary", "description": "Domain layer must have zero external dependencies", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R04", "severity": "MUST", "category": "communication", "title": "Inter-Context Communication via Ports", "description": "Cross-context communication must use port interfaces", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R05", "severity": "MUST", "category": "persistence", "title": "No Shared Database", "description": "Each bounded context must have own schema", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R06", "severity": "MUST", "category": "async-boundaries", "title": "Async Events Use Domain Events", "description": "Event-driven reactions subscribe to domain event types", "blocking": false, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R07", "severity": "MUST", "category": "extraction-readiness", "title": "Maintain Extraction Readiness Score", "description": "Extraction readiness assessment must exist", "blocking": false, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R08", "severity": "MUST", "category": "observability", "title": "Observability Instrumentation", "description": "All bounded contexts must emit OTel traces", "blocking": false, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R09", "severity": "MUST", "category": "dependency-injection", "title": "Strict DIP", "description": "No manual new Service instantiation", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R10", "severity": "MUST", "category": "static-analysis", "title": "AST-Based Analysis Mandatory", "description": "Static analysis must use AST not regex", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R11", "severity": "MUST", "category": "separation-of-concerns", "title": "Strict UI and Logic Isolation", "description": "UI must not leak into Application/Domain logic", "blocking": true, "sourceFile": "modular-monolith.rules.json" },
    { "id": "MM-R12", "severity": "SHOULD", "category": "domain-purity", "title": "Pure Domain Model", "description": "Domain entities should not reference persistence frameworks", "blocking": false, "sourceFile": "modular-monolith.rules.json" }
  ],
  "scenarios": {
