{
  "domain": "mcp",
  "description": "MCP protocol compliance rule evaluator parity — MCP rules. GT-716 AC4: absent smoke evidence FAILS MCP-01..03, the same verdict and words as mcp.rego — the evidence is an observed fact of the checkout, and its absence is the finding.",
  "rules": [
    { "id": "MCP-01", "severity": "MUST", "category": "mcp", "title": "Initialize Request Must Return Capabilities", "description": "The MCP server must respond to initialize with protocolVersion, capabilities, and serverInfo", "blocking": true, "sourceFile": "protocol-compliance.rules.json" },
    { "id": "MCP-02", "severity": "MUST", "category": "mcp", "title": "Tools List Must Be Complete and Stable", "description": "tools/list must expose every supported tool with name, description, and inputSchema", "blocking": true, "sourceFile": "protocol-compliance.rules.json" },
    { "id": "MCP-03", "severity": "MUST", "category": "mcp", "title": "Resources Must Preserve Core Traceability", "description": "resources/read responses must identify the Core artifact source", "blocking": true, "sourceFile": "protocol-compliance.rules.json" },
    { "id": "MCP-04", "severity": "MUST", "category": "mcp", "title": "HTTP Transport Requires Explicit Authentication", "description": "HTTP transport must have API key or local-only mode", "blocking": true, "sourceFile": "protocol-compliance.rules.json" }
  ],
  "scenarios": {
    "compliant": {
      "filesystem": {
        "existing": ["/core/.harness/evidence", "/core/src/packages/mcp-server/src/mcp/mcp-server.service.ts"],
        "dirs": { "/core/.harness/evidence": ["mcp-smoke.json"] },
        "files": {
          "/core/.harness/evidence/mcp-smoke.json": "{\"status\":\"passed\",\"results\":{\"initialize\":{},\"tools/list\":{},\"resources/list\":{}}}",
          "/core/src/packages/mcp-server/src/mcp/mcp-server.service.ts": "const apiKey = process.env.MCP_API_KEY;"
        }
      },
      "context": { "satellitePath": "/sat", "corePath": "/core" },
      "expectedResults": [
        { "ruleId": "MCP-01", "result": "passed" },
        { "ruleId": "MCP-02", "result": "passed" },
        { "ruleId": "MCP-03", "result": "passed" },
        { "ruleId": "MCP-04", "result": "passed" }
      ]
    },
    "no-smoke-evidence": {
      "filesystem": {
        "existing": ["/core/.harness/evidence"],
        "dirs": { "/core/.harness/evidence": ["other.json"] },
        "files": {}
      },
      "context": { "satellitePath": "/sat", "corePath": "/core" },
      "expectedResults": [
        { "ruleId": "MCP-01", "result": "failed" },
        { "ruleId": "MCP-02", "result": "failed" },
        { "ruleId": "MCP-03", "result": "failed" },
        { "ruleId": "MCP-04", "result": "skipped" }
      ]
    },
    "missing-initialize": {
      "filesystem": {
        "existing": ["/core/.harness/evidence"],
        "dirs": { "/core/.harness/evidence": ["mcp-smoke.json"] },
        "files": {
          "/core/.harness/evidence/mcp-smoke.json": "{\"status\":\"passed\",\"results\":{\"tools/list\":{},\"resources/list\":{}}}"
        }
      },
      "context": { "satellitePath": "/sat", "corePath": "/core" },
      "expectedResults": [
        { "ruleId": "MCP-01", "result": "failed" },
        { "ruleId": "MCP-02", "result": "passed" },
        { "ruleId": "MCP-03", "result": "passed" },
        { "ruleId": "MCP-04", "result": "skipped" }
      ]
    },
    "no-auth-on-server": {
      "filesystem": {
        "existing": ["/core/.harness/evidence", "/core/src/packages/mcp-server/src/mcp/mcp-server.service.ts"],
        "dirs": { "/core/.harness/evidence": ["mcp-smoke.json"] },
        "files": {
          "/core/.harness/evidence/mcp-smoke.json": "{\"status\":\"passed\",\"results\":{\"initialize\":{},\"tools/list\":{},\"resources/list\":{}}}",
          "/core/src/packages/mcp-server/src/mcp/mcp-server.service.ts": "const open = true;"
        }
      },
      "context": { "satellitePath": "/sat", "corePath": "/core" },
      "expectedResults": [
        { "ruleId": "MCP-01", "result": "passed" },
        { "ruleId": "MCP-02", "result": "passed" },
        { "ruleId": "MCP-03", "result": "passed" },
        { "ruleId": "MCP-04", "result": "failed" }
      ]
    }
  }
}
