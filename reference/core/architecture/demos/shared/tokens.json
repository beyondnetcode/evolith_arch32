    "interfaces":   { "light": ["#FDF6E7", "#E3C58A", "#7A5210"], "dark": ["#2A2110", "#7A5A20", "#F2CF83"] },
    "constitution": { "light": ["#EAF4F8", "#9EC5D6", "#155E78"], "dark": ["#0F232C", "#2C6579", "#9AD3EA"] },
