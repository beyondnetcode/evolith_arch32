{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/evolith-user-story.schema.json",
  "title": "User Story Evolith",
  "description": "JSON Schema for validating Evolith User Story artifacts. Atomic business-readable behavior specifications with BDD acceptance criteria.",
  "type": "object",
  "required": ["storyId", "title", "role", "action", "benefit", "acceptanceCriteria"],
  "additionalProperties": false,
  "properties": {
    "storyId": {
      "type": "string",
      "pattern": "^(US|TS|EN|DEBT)-\\d{3}$",
      "description": "Story ID following pattern: US-XXX (User Story), TS-XXX (Technical), EN-XXX (Enabler), DEBT-XXX (Debt)."
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "description": "User-facing title in business language."
    },
    "type": {
      "type": "string",
      "enum": ["Functional", "Technical", "Enabler", "Debt"],
      "default": "Functional"
    },
    "role": {
      "type": "string",
      "description": "Actor or persona who performs the action (As a...)."
    },
    "action": {
      "type": "string",
      "description": "Action to perform (I want to...)."
    },
    "benefit": {
      "type": "string",
      "description": "Business value or benefit (So that...)."
    },
    "epic": {
      "type": "string",
      "description": "Parent epic or initiative this story belongs to."
    },
    "boundedContext": {
      "type": "string",
      "description": "Domain bounded context this story belongs to."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "default": "1.0"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "scenario": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      },
      "minItems": 1,
      "description": "BDD-format acceptance criteria (Given/When/Then)."
    },
    "technicalRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundedContext": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "External APIs, databases, or services this story depends on."
        },
        "nonFunctionalRequirements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Ready", "In Progress", "Done", "Blocked"],
      "default": "Draft"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Priority: 1 = highest priority."
    },
    "storyPoints": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"],
      "description": "T-Shirt size estimation."
    },
    "relatedADRs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ADR IDs that constrain or enable this story."
    }
  }
}