{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/gitflow-branching.input.schema.json",
  "title": "GitFlow Branching OPA Policy Input Schema",
  "type": "object",
  "required": ["satellite"],
  "properties": {
    "satellite": {
      "type": "object",
      "required": ["git"],
      "properties": {
        "git": {
          "type": "object",
          "required": [
            "branchNameInvalid",
            "directPushToProtectedBranch",
            "prHasMinimumReview",
            "releaseTagInvalid",
            "commitMessageInvalid",
            "promotionSequenceInvalid",
            "higherEnvPrHasTwoApprovals"
          ],
          "properties": {
            "branchNameInvalid": { "type": "boolean" },
            "directPushToProtectedBranch": { "type": "boolean" },
            "prHasMinimumReview": { "type": "boolean" },
            "releaseTagInvalid": { "type": "boolean" },
            "commitMessageInvalid": { "type": "boolean" },
            "promotionSequenceInvalid": { "type": "boolean" },
            "higherEnvPrHasTwoApprovals": { "type": "boolean" }
          }
        }
      }
    }
  }
}
