{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/knowledge-intake.schema.json",
  "title": "External Knowledge Intake Candidate",
  "type": "object",
  "required": ["knowledge_id", "source", "assessment", "promotion", "review", "synthesis"],
  "properties": {
    "knowledge_id": { "type": "string", "pattern": "^KI-[A-Z0-9-]+$" },
    "source": {
      "type": "object",
      "required": ["class", "author", "work", "locator", "retrieved_at", "rights_status"],
      "properties": {
        "class": { "enum": ["book", "public-article", "official-docs"] },
        "author": { "type": "string", "minLength": 1 },
        "work": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date" },
        "rights_status": { "enum": ["citation-and-synthesis-only", "public-reference", "official-documentation"] }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["trust_level", "portability", "topologies", "concerns"],
      "properties": {
        "trust_level": { "enum": ["primary", "secondary"] },
        "portability": { "enum": ["high", "medium", "low"] },
        "topologies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "concerns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["candidate", "evaluated", "accepted", "executable", "retired"] },
        "adr": { "type": ["string", "null"] },
        "native_rule": { "type": ["string", "null"] },
        "opa_policy": { "type": ["string", "null"] },
        "fixtures": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["owner", "next_review_at"],
      "properties": {
        "owner": { "const": "@wilson" },
        "next_review_at": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "synthesis": { "type": "string", "minLength": 40, "maxLength": 3000 }
  },
  "additionalProperties": false
}
