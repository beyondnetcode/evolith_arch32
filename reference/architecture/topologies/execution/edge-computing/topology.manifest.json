{
  "apiVersion": "evolith.dev/topology/v1",
  "kind": "TopologyManifest",
  "metadata": {
    "id": "edge-computing",
    "name": "Edge Computing",
    "dimension": "execution",
    "status": "accepted",
    "version": "1.0.0"
  },
  "spec": {
    "summary": "Execution topology for workloads placed near users, devices, regions, or constrained networks while preserving Evolith domain ownership and governance contracts.",
    "topologyType": "edge-computing",
    "compatibility": {
      "progressiveAxis": {
        "phase": "cross",
        "profile": "cross"
      },
      "composableWith": [
        "microservices",
        "distributed-modules",
        "event-driven",
        "serverless",
        "agentic-ai"
      ]
    },
    "artifacts": {
      "adrs": [
        "reference/architecture/adrs/core/0079-multi-topology-reference-corpus.md",
        "reference/architecture/adrs/core/0096-edge-computing-architecture-governance.md"
      ],
      "rulesets": [
        "reference/architecture/topologies/execution/edge-computing/edge-computing.rules.json"
      ],
      "opaPolicies": [
        "reference/architecture/topologies/execution/edge-computing/edge-computing.rego"
      ],
      "aiRulesets": [
        "reference/architecture/topologies/execution/edge-computing/README.md"
      ],
      "umsContracts": [
        "reference/knowledge/demo/ums-reference-model.md"
      ]
    },
    "corpus": {
      "guidance": {
        "profile": "reference/architecture/topologies/execution/edge-computing/README.md",
        "maturityGuide": "reference/architecture/topologies/execution/edge-computing/maturity.md"
      },
      "configurationContract": "reference/architecture/topologies/execution/edge-computing/topology.config.schema.json",
      "fixtures": {
        "valid": "reference/architecture/topologies/execution/edge-computing/fixtures/valid.topology.config.json",
        "invalid": "reference/architecture/topologies/execution/edge-computing/fixtures/invalid.topology.config.json"
      },
      "nativeEvaluator": "packages/core-domain/src/application/validators/ruleset-validator.service.ts",
      "tests": {
        "positive": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts",
        "negative": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts"
      },
      "evidence": "reference/governance/standards/vision/maturity-evidence.json"
    },
    "operationalBudgets": {
      "latencyBudgetMs": 200,
      "coldStartCeilingMs": 300,
      "costEnvelopePerExecutionCents": 1
    },
    "operationalInterfaces": {
      "cli": {
        "validators": [
          "validate-architecture",
          "validate-topology"
        ]
      },
      "mcp": {
        "resources": [
          "evolith://topologies/edge-computing/manifest",
          "evolith://topologies/edge-computing/rulesets"
        ],
        "tools": [
          "evolith-topology-inspect",
          "evolith-topology-validate"
        ],
        "prompts": [
          "topology-aware-implementation",
          "extraction-readiness-review"
        ]
      },
      "coreApi": {
        "endpoints": [
          "GET /topologies/{id}",
          "GET /topologies/{id}/manifest",
          "POST /topologies/{id}/validate"
        ]
      }
    }
  },
  "businessBoundary": {
    "technicalOnly": true,
    "trackerOwns": [
      "timing",
      "ownership",
      "prioritization",
      "roi",
      "cost",
      "budget",
      "funnel-0"
    ]
  }
}
