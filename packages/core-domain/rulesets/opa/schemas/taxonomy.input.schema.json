{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/taxonomy.input.schema.json",
  "title": "Taxonomy OPA Policy Input Schema",
  "type": "object",
  "required": ["core", "satellitePath", "corePath", "satellite"],
  "properties": {
    "satellitePath": { "type": "string" },
    "corePath": { "type": "string" },
    "core": {
      "type": "object",
      "required": ["directories", "adrs"],
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "adrs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "satellite": {
      "type": "object",
      "required": ["directories"],
      "properties": {
        "packageJson": { "type": ["object", "null"] },
        "directories": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
