{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/evolith-yaml.schema.json",
  "title": "Evolith Satellite Contract",
  "description": "JSON Schema for validating satellite repository evolith.yaml files. This is the federated governance contract.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "evolith.dev/v1",
      "description": "Evolith API version. Must be evolith.dev/v1."
    },
    "kind": {
      "type": "string",
      "const": "Satellite",
      "description": "Kind of Evolith resource. Must be Satellite."
    },
    "metadata": {
      "type": "object",
      "required": ["name", "phase", "architectureVersion"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Satellite repository name. kebab-case, lowercase."
        },
        "phase": {
          "type": "string",
          "enum": ["F1", "F2", "F3"],
          "description": "Current progressive-axis compatibility phase: F1=modular-monolith, F2=distributed-modules, F3=microservices. Other topology dimensions are resolved through topology manifests."
        },
        "architectureVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Satellite's own semantic version for tracking architectural changes."
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["coreRef", "runtime", "sdlc", "compliance"],
      "additionalProperties": false,
      "properties": {
        "coreRef": {
          "type": "object",
          "required": ["version", "rulesetVersion"],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Evolith Core version this satellite inherits from."
            },
            "rulesetVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Specific ruleset version from Core that this satellite pins to."
            },
            "inheritancePath": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Chain of inheritance if satellite extends another satellite."
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["language", "framework"],
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "enum": ["TypeScript", "CSharp", "Kotlin", "Go", "Python"],
              "description": "Primary implementation language."
            },
            "framework": {
              "type": "string",
              "description": "Framework used (e.g., NestJS, ASP.NET Core, Spring Boot)."
            },
            "runtimeVersion": {
              "type": "string",
              "description": "Runtime version (e.g., Node 20, .NET 8, Android API 34)."
            }
          }
        },
        "sdlc": {
          "type": "object",
          "required": ["currentPhase", "gates"],
          "additionalProperties": false,
          "properties": {
            "currentPhase": {
              "type": "integer",
              "enum": [1, 2, 3, 4, 5],
              "description": "Current SDLC phase (1=Conception, 2=Design, 3=Construction, 4=Validation, 5=Delivery)."
            },
            "gates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "businessSignOff": { "type": "string", "format": "date" },
                "designBaseline": { "type": "string", "format": "date" },
                "successfulBuild": { "type": "string", "format": "date" },
                "rcStamped": { "type": "string", "format": "date" },
                "productionLive": { "type": "string", "format": "date" }
              }
            }
          }
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "description": "Design-phase declaration (ADR-0104). Technical-only per ADR-0079 businessBoundary. Advisory: F1/F2/F3 are optional, overridable, and extensible; a topology composition (array) supports mixed topologies.",
          "properties": {
            "topology": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "recommended": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Topology (or composition) recommended in Discovery. Advisory."
                },
                "confirmed": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Topology composition confirmed in Design; drives the designProfile union (ADR-0104)."
                }
              }
            }
          }
        },
        "boundedContexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "phase"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "phase": { "type": "string", "enum": ["F1", "F2", "F3"] },
              "persistence": {
                "type": "string",
                "enum": ["PostgreSQL", "MongoDB", "SQLServer", "SQLite"]
              }
            }
          },
          "description": "Bounded contexts defined in this satellite."
        },
        "compliance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adrRegistry": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Local ADRs maintained by this satellite (not yet promoted to Core). Each ADR file must have 'EvolithSatellite' in frontmatter tags to distinguish from Core ADRs."
            },
            "localAdrTagEnforcement": {
              "type": "string",
              "enum": ["enforced", "documented"],
              "default": "enforced",
              "description": "Whether local ADR tag enforcement is automated (enforced) or documented only. Defaults to enforced."
            },
            "coverageTarget": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Coverage target for this satellite (minimum 80)."
            },
            "qualityWaivers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "criterion": { "type": "string" },
                  "justification": { "type": "string" },
                  "expires": { "type": "string", "format": "date" }
                }
              },
              "description": "Active quality waivers with expiration dates."
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executiveSponsor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "lastReviewDate": { "type": "string", "format": "date" }
              },
              "description": "Executive sponsor responsible for quarterly governance review. Required for SPACE-05 metric compliance."
            },
            "nextReviewDate": {
              "type": "string",
              "format": "date",
              "description": "Date of next scheduled governance review."
            }
          },
          "description": "Executive governance metadata for scorecard metrics."
        }
      }
    }
  }
}
