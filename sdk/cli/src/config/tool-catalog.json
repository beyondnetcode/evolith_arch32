{
  "_comment": "Evolith Tool Catalog per Phase - Extensible, runtime-aware",
  "catalogVersion": "1.0.0",
  "lastUpdated": "2026-06-06",

  "phases": {
    "phase-0": {
      "description": "Foundation - Repository initialized",
      "gateChecks": ["evolith.yaml exists", "coreRef.version pinned"],
      "artifacts": ["evolith.yaml", "README.md", "evolith-product-vision-master.md"]
    },

    "phase-1": {
      "description": "Structure - Project scaffolded",
      "gateChecks": ["package.json exists", "src/ directory exists", "bilingual README"],
      "artifacts": ["package.json", "src/", "README.es.md"],

      "toolGroups": {
        "runtime": {
          "question": "¿Qué runtime usarás?",
          "defaultOption": "nodejs",
          "optionsFromCatalog": true,
          "toolMapping": {
            "nodejs": ["tsc", "jest", "eslint", "prettier"],
            "typescript": ["tsc", "jest", "eslint", "prettier"],
            "dotnet": ["dotnet CLI", "xUnit", "dotnet-format"],
            "python": ["pytest", "black", "ruff", "mypy"]
          }
        },
        "monorepo": {
          "question": "¿Monorepo? (Convention: None para projects pequeños)",
          "defaultOption": "none",
          "optionsFromCatalog": true,
          "toolMapping": {
            "nx": ["nx", "@nx/js", "@nx/node"],
            "npm-workspaces": ["npm"],
            "pnpm-workspaces": ["pnpm"],
            "rush": ["@microsoft/rush"],
            "none": []
          }
        },
        "architecture": {
          "question": "¿Patrón de arquitectura?",
          "defaultOption": "clean",
          "optionsFromCatalog": true,
          "scaffoldCommands": {
            "clean": "evolith scaffold --pattern=clean",
            "hexagonal": "evolith scaffold --pattern=hexagonal",
            "ddd": "evolith scaffold --pattern=ddd",
            "event-driven": "evolith scaffold --pattern=event-driven"
          }
        },
        "database": {
          "question": "¿Base de datos?",
          "defaultOption": "postgresql",
          "optionsFromCatalog": true,
          "toolMapping": {
            "postgresql": ["typeorm", "pg", "ef-core", "sqlalchemy"],
            "mongodb": ["mongoose", "mongodb-driver", "mongo"],
            "sqlserver": ["ef-core", "mssql"],
            "sqlite": ["better-sqlite3", "ef-core"]
          }
        },
        "apiProtocol": {
          "question": "¿Protocolo API?",
          "defaultOption": "rest",
          "optionsFromCatalog": true,
          "toolMapping": {
            "rest": ["swagger", "openapi"],
            "graphql": ["apollo", "graphql"],
            "grpc": ["grpc-tools", "protobuf"]
          }
        }
      },

      "defaultTools": {
        "nodejs": ["typescript", "jest", "eslint", "prettier", "husky"],
        "typescript": ["typescript", "jest", "eslint", "prettier", "husky"],
        "dotnet": [".NET SDK", "xUnit", "dotnet-format"],
        "python": ["pytest", "black", "ruff", "mypy"]
      }
    },

    "phase-2": {
      "description": "Governance - Rulesets and ACL configured",
      "gateChecks": ["rulesets/ exists", "ACL rules present", ".harness/ exists"],
      "artifacts": ["rulesets/", ".harness/", "acl/"],

      "toolGroups": {
        "acl": {
          "question": "¿Validación ACL?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Anti-Corruption Layer con validación de esquemas" },
            { "value": "minimal", "label": "Mínimo", "description": "Solo logging de transformaciones" },
            { "value": "no", "label": "No", "description": "Avanzar sin validación ACL" }
          ],
          "tools": ["acl-schema-validator", "transformation-logger"]
        },
        "adr": {
          "question": "¿Sistema ADR?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "ADR completo con matriz y templates" },
            { "value": "minimal", "label": "Mínimo", "description": "Solo registro sin template" },
            { "value": "no", "label": "No", "description": "Avanzar sin ADR" }
          ],
          "tools": ["adr-create", "adr-matrix", "adr-template"]
        },
        "hooks": {
          "question": "¿Git hooks?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí (Husky)", "description": "Pre-commit con validación Evolith" },
            { "value": "lefthook", "label": "Lefthook", "description": "Alternativa multiplataforma" },
            { "value": "no", "label": "No", "description": "Avanzar sin hooks" }
          ],
          "tools": ["husky", "lefthook"]
        },
        "bilingual": {
          "question": "¿Documentación bilingüe?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "EN + ES para toda la documentación" },
            { "value": "es-only", "label": "Solo ES", "description": "Solo español" },
            { "value": "no", "label": "No", "description": "Solo inglés" }
          ],
          "tools": ["check-bilingual-parity", "bilingual-coverage"]
        }
      },

      "defaultTools": ["acl-schema-validator", "adr-registry", "husky", "validate-docs", "check-bilingual-parity"]
    },

    "phase-3": {
      "description": "Architecture - ADRs and Bounded Contexts defined",
      "gateChecks": ["ADR exists", "ADR matrix updated", "Bounded context map defined"],
      "artifacts": ["reference/architecture/adrs/", "bounded-context-map.json"],

      "toolGroups": {
        "contextMapping": {
          "question": "¿Context Mapping?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Bounded Context Map completo" },
            { "value": "minimal", "label": "Mínimo", "description": "Solo lista de contextos" },
            { "value": "no", "label": "No", "description": "Avanzar sin context mapping" }
          ],
          "tools": ["context-mapper", "context-map-renderer"]
        },
        "adrCreation": {
          "question": "¿Creación ADR?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Templates y COMandos ADR" },
            { "value": "manual", "label": "Manual", "description": "Solo templates, sin comandos" },
            { "value": "no", "label": "No", "description": "Avanzar sin ADR tooling" }
          ],
          "tools": ["adr-create", "adr-template"]
        },
        "contracts": {
          "question": "¿Contracts Registry?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Inter-context contracts documentados" },
            { "value": "openapi", "label": "OpenAPI only", "description": "Contracts via OpenAPI spec" },
            { "value": "no", "label": "No", "description": "Avanzar sin contract registry" }
          ],
          "tools": ["contract-registry", "openapi-generator"]
        },
        "events": {
          "question": "¿Event Schemas?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Event Schema Registry completo" },
            { "value": "kafka", "label": "Kafka Schema Registry", "description": "Confluent Schema Registry" },
            { "value": "no", "label": "No", "description": "Avanzar sin event schemas" }
          ],
          "tools": ["event-schema-registry", "schema-validator"]
        },
        "patterns": {
          "question": "¿Patrones adicionales?",
          "defaultOption": "none",
          "options": [
            { "value": "none", "label": "Ninguno", "description": "Sin patrones adicionales" },
            { "value": "event-sourcing", "label": "Event Sourcing", "description": "Event store para agregados" },
            { "value": "cqrs", "label": "CQRS", "description": "Command Query Separation" },
            { "value": " saga", "label": "Saga/Orchestration", "description": "Transacciones distribuidas" }
          ],
          "tools": ["event-store", "cqrs-projections", "saga-orchestrator"]
        }
      },

      "defaultTools": ["context-mapper", "adr-create", "contract-registry", "event-schema-registry"]
    },

    "phase-4": {
      "description": "Production - Container, CI/CD, Observability",
      "gateChecks": ["Dockerfile exists", "CI/CD configured", "DORA metrics"],
      "artifacts": ["Dockerfile", ".github/workflows/", "observability.config.json"],

      "toolGroups": {
        "container": {
          "question": "¿Container?",
          "defaultOption": "docker",
          "options": [
            { "value": "docker", "label": "Docker", "description": "Dockerfile + Docker Compose" },
            { "value": "docker-kaniko", "label": "Docker + Kaniko", "description": "Build sin Docker daemon" },
            { "value": "buildpacks", "label": "Cloud Native Buildpacks", "description": "Pack para builds automáticos" },
            { "value": "none", "label": "No", "description": "Avanzar sin container" }
          ],
          "tools": ["dockerfile-generator", "docker-compose-dev"]
        },
        "cicd": {
          "question": "¿CI/CD?",
          "defaultOption": "github-actions",
          "options": [
            { "value": "github-actions", "label": "GitHub Actions", "description": "Workflows en .github/workflows/" },
            { "value": "gitlab-ci", "label": "GitLab CI", "description": ".gitlab-ci.yml" },
            { "value": "azure-pipelines", "label": "Azure Pipelines", "description": "azure-pipelines.yml" },
            { "value": "jenkins", "label": "Jenkins", "description": "Jenkinsfile" },
            { "value": "none", "label": "No", "description": "Avanzar sin CI/CD" }
          ],
          "tools": ["ci-workflow-generator", "cd-pipeline"]
        },
        "orchestration": {
          "question": "¿Orquestación?",
          "defaultOption": "none",
          "options": [
            { "value": "none", "label": "None (dev/test)", "description": "Solo Docker, no K8s" },
            { "value": "kubernetes", "label": "Kubernetes", "description": "Helm + manifests" },
            { "value": "docker-swarm", "label": "Docker Swarm", "description": "Stack compose" }
          ],
          "tools": ["k8s-manifests", "helm-chart", "ingress-controller"]
        },
        "secrets": {
          "question": "¿Secrets management?",
          "defaultOption": "env",
          "options": [
            { "value": "env", "label": "Environment vars", "description": "Simple, file-based (.env)" },
            { "value": "vault", "label": "HashiCorp Vault", "description": "Dynamic secrets, rotation" },
            { "value": "aws-secrets", "label": "AWS Secrets Manager", "description": "Para AWS deployments" },
            { "value": "azure-keyvault", "label": "Azure Key Vault", "description": "Para Azure deployments" }
          ],
          "tools": ["secrets-injector", "vault-agent", "aws-secrets-sync"]
        }
      },

      "defaultTools": ["dockerfile", "github-actions", "otel-instrumentation", "env-secrets"]
    },

    "phase-5": {
      "description": "Observability - DORA metrics, alerting, dashboards",
      "gateChecks": ["Metrics collected", "Traces instrumented", "Logs aggregated"],
      "artifacts": ["grafana-dashboard.json", "alert-rules.yaml", "slo-config.json"],

      "toolGroups": {
        "tracing": {
          "question": "¿Tracing?",
          "defaultOption": "jaeger",
          "options": [
            { "value": "jaeger", "label": "Jaeger", "description": "OpenTelemetry-compatible tracer" },
            { "value": "zipkin", "label": "Zipkin", "description": "Legacy compatible" },
            { "value": "aws-xray", "label": "AWS X-Ray", "description": "Para AWS" },
            { "value": "none", "label": "No", "description": "Sin distributed tracing" }
          ],
          "tools": ["jaeger-agent", "otel-collector-trace"]
        },
        "metrics": {
          "question": "¿Metrics?",
          "defaultOption": "prometheus",
          "options": [
            { "value": "prometheus", "label": "Prometheus", "description": "Pull-based metrics" },
            { "value": "datadog", "label": "Datadog", "description": "APM + metrics" },
            { "value": "cloudwatch", "label": "CloudWatch", "description": "AWS metrics" },
            { "value": "none", "label": "No", "description": "Sin metrics" }
          ],
          "tools": ["prometheus-server", "node-exporter", "metrics-adapter"]
        },
        "logs": {
          "question": "¿Log aggregation?",
          "defaultOption": "loki",
          "options": [
            { "value": "loki", "label": "Loki", "description": "Log aggregation, Prometheus-compatible" },
            { "value": "elasticsearch", "label": "Elasticsearch", "description": "ELK stack" },
            { "value": "cloudwatch-logs", "label": "CloudWatch Logs", "description": "AWS log aggregation" },
            { "value": "none", "label": "No", "description": "Sin log aggregation" }
          ],
          "tools": ["loki", "promtail", "logcli"]
        },
        "visualization": {
          "question": "¿Dashboards?",
          "defaultOption": "grafana",
          "options": [
            { "value": "grafana", "label": "Grafana", "description": "Dashboards + alerting" },
            { "value": "datadog-dashboards", "label": "Datadog", "description": "Dashboards Included" },
            { "value": "none", "label": "No", "description": "Sin dashboards" }
          ],
          "tools": ["grafana-server", "datasource-config", "dashboard-templates"]
        },
        "alerting": {
          "question": "¿Alerting?",
          "defaultOption": "grafana-alerts",
          "options": [
            { "value": "grafana-alerts", "label": "Grafana Alerting", "description": "Integrado con Grafana" },
            { "value": "pagerduty", "label": "PagerDuty", "description": "Incident management" },
            { "value": "opsgenie", "label": "OpsGenie", "description": "Alert routing" },
            { "value": "none", "label": "No", "description": "Sin alerting configurado" }
          ],
          "tools": ["alert-rules", "notification-channel", "incident-routing"]
        },
        "dora": {
          "question": "¿DORA metrics?",
          "defaultOption": "yes",
          "options": [
            { "value": "yes", "label": "Sí", "description": "Deployment frequency, Lead time, MTTR, Change failure rate" },
            { "value": "minimal", "label": "Mínimo", "description": "Solo deployment frequency" },
            { "value": "no", "label": "No", "description": "Sin tracking DORA" }
          ],
          "tools": ["dora-collector", "dora-dashboard", "devopsyaml"]
        }
      },

      "defaultTools": ["jaeger", "prometheus", "loki", "grafana", "otel-collector", "dora-metrics"]
    }
  },

  "toolMetadata": {
    "acl-schema-validator": {
      "description": "Valida datos externos contra esquemas Core",
      "runtimeAgnostic": true,
      "phase": "phase-2"
    },
    "adr-create": {
      "description": "Genera templates y comandos ADR",
      "runtimeAgnostic": true,
      "phase": "phase-3"
    },
    "context-mapper": {
      "description": "Define y documenta bounded contexts",
      "runtimeAgnostic": true,
      "phase": "phase-3"
    },
    "dockerfile-generator": {
      "description": "Genera Dockerfile optimizado por runtime",
      "runtimeAware": true,
      "phase": "phase-4"
    },
    "otel-instrumentation": {
      "description": "Instrumentación OpenTelemetry",
      "runtimeAware": true,
      "phase": "phase-4"
    },
    "dora-metrics": {
      "description": "Colección automática de DORA metrics",
      "runtimeAgnostic": true,
      "phase": "phase-5"
    }
  }
}