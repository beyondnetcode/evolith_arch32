{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/evaluation-result.schema.json",
  "title": "Evaluation Result",
  "description": "GT-377 / ADR-0101. What the stateless Core Evaluation Engine RETURNS (wrapped in the ADR-0073 SuccessEnvelope at transport). The Core EVALUATES; it never decides the canonical GateDecision. Any DecisionRecommendation is NON-BINDING (binding === false). Mirrors packages/core-domain/src/evaluation/contracts/evaluation-result.ts.",
  "type": "object",
  "required": [
    "overallVerdict", "outcome", "results", "rulesExecuted", "policiesApplied",
    "gaps", "risks", "missingEvidence", "incompleteArtifacts", "recommendations",
    "requiredActions", "confidence", "rationale", "versions", "evaluatedAt", "schemaVersion"
  ],
  "properties": {
    "overallVerdict": { "$ref": "#/definitions/verdict" },
    "outcome": { "type": "string", "enum": ["approved", "rejected", "conditional", "pending", "requires_manual_review"] },
    "results": {
      "type": "object",
      "properties": {
        "gate": { "type": "array", "items": { "$ref": "#/definitions/gateResult" } },
        "artifact": { "type": "array", "items": { "$ref": "#/definitions/artifactResult" } },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceResult" } },
        "architecture": { "$ref": "#/definitions/architectureResult" },
        "blueprint": { "$ref": "#/definitions/blueprintResult" },
        "topology": { "$ref": "#/definitions/topologyResult" },
        "checkpoint": { "type": "array", "items": { "$ref": "#/definitions/checkpointResult" } },
        "deployment": { "$ref": "#/definitions/deploymentResult" },
        "compliance": { "$ref": "#/definitions/complianceResult" },
        "design": { "$ref": "#/definitions/designResult" }
      }
    },
    "rulesExecuted": { "type": "array", "items": { "$ref": "#/definitions/ruleExecutionRef" } },
    "policiesApplied": { "type": "array", "items": { "$ref": "#/definitions/ruleExecutionRef" } },
    "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
    "risks": { "type": "array", "items": { "$ref": "#/definitions/riskFinding" } },
    "missingEvidence": { "type": "array", "items": { "type": "string" } },
    "incompleteArtifacts": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/definitions/recommendation" } },
    "requiredActions": { "type": "array", "items": { "$ref": "#/definitions/requiredAction" } },
    "decisionRecommendation": { "$ref": "#/definitions/decisionRecommendation" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string" },
    "versions": {
      "type": "object",
      "required": ["core"],
      "properties": {
        "core": { "type": "string" },
        "ruleset": { "type": "string" },
        "rulesetVersion": { "type": "string" },
        "policy": { "type": "string" },
        "blueprint": { "type": "string" }
      }
    },
    "evaluatedAt": { "type": "string" },
    "correlationId": { "type": "string" },
    "schemaVersion": { "type": "string" }
  },
  "definitions": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "WAIVE", "SKIP"] },
    "findingSeverity": { "type": "string", "enum": ["error", "warning", "info"] },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "riskFinding": {
      "type": "object",
      "required": ["id", "level", "category", "message"],
      "properties": {
        "id": { "type": "string" },
        "level": { "$ref": "#/definitions/riskLevel" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "ruleRef": { "type": "string" }
      }
    },
    "gapFinding": {
      "type": "object",
      "required": ["id", "requirementRef", "severity", "message"],
      "properties": {
        "id": { "type": "string" },
        "requirementRef": { "type": "string" },
        "severity": { "$ref": "#/definitions/findingSeverity" },
        "message": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "requiredAction": {
      "type": "object",
      "required": ["id", "description", "blocking", "remediation"],
      "properties": {
        "id": { "type": "string" },
        "gapId": { "type": "string" },
        "description": { "type": "string" },
        "blocking": { "type": "boolean" },
        "remediation": { "type": "string" }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["id", "kind", "message"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["architecture", "topology", "process", "remediation", "next-step"] },
        "message": { "type": "string" },
        "rationale": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decisionRecommendation": {
      "type": "object",
      "required": ["subjectType", "subjectRef", "recommendedVerdict", "binding", "recommendedBy"],
      "properties": {
        "subjectType": { "type": "string", "enum": ["gate", "phase", "initiative", "product"] },
        "subjectRef": { "type": "string" },
        "recommendedVerdict": { "$ref": "#/definitions/verdict" },
        "reason": { "type": "string" },
        "binding": { "const": false },
        "recommendedBy": { "const": "evolith-core" }
      }
    },
    "ruleExecutionRef": {
      "type": "object",
      "required": ["ruleId", "engine", "verdict"],
      "properties": {
        "ruleId": { "type": "string" },
        "rulesetRef": { "type": "string" },
        "engine": { "type": "string", "enum": ["native", "opa"] },
        "verdict": { "$ref": "#/definitions/verdict" }
      }
    },
    "artifactResult": {
      "type": "object",
      "required": ["artifactId", "verdict", "present", "ruleRefs", "gaps"],
      "properties": {
        "artifactId": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "present": { "type": "boolean" },
        "ruleRefs": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } }
      }
    },
    "gateResult": {
      "type": "object",
      "required": ["gateId", "verdict", "artifactResults", "risks", "gaps", "requiredActions"],
      "properties": {
        "gateId": { "type": "string" },
        "phaseId": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "artifactResults": { "type": "array", "items": { "$ref": "#/definitions/artifactResult" } },
        "risks": { "type": "array", "items": { "$ref": "#/definitions/riskFinding" } },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "requiredActions": { "type": "array", "items": { "$ref": "#/definitions/requiredAction" } }
      }
    },
    "evidenceResult": {
      "type": "object",
      "required": ["evidenceId", "verdict", "sufficient", "integrityVerified", "gaps"],
      "properties": {
        "evidenceId": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "sufficient": { "type": "boolean" },
        "integrityVerified": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } }
      }
    },
    "architectureResult": {
      "type": "object",
      "required": ["verdict", "risks", "gaps", "recommendations"],
      "properties": {
        "verdict": { "$ref": "#/definitions/verdict" },
        "definitionRef": { "type": "string" },
        "risks": { "type": "array", "items": { "$ref": "#/definitions/riskFinding" } },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "recommendations": { "type": "array", "items": { "$ref": "#/definitions/recommendation" } }
      }
    },
    "blueprintResult": {
      "type": "object",
      "required": ["blueprintRef", "verdict", "gaps", "requiredActions"],
      "properties": {
        "blueprintRef": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "requiredActions": { "type": "array", "items": { "$ref": "#/definitions/requiredAction" } }
      }
    },
    "topologyResult": {
      "type": "object",
      "required": ["topologyRef", "verdict", "conformant", "gaps", "recommendations"],
      "properties": {
        "topologyRef": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "conformant": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "recommendations": { "type": "array", "items": { "$ref": "#/definitions/recommendation" } }
      }
    },
    "checkpointResult": {
      "type": "object",
      "required": ["checkpointId", "verdict", "gaps"],
      "properties": {
        "checkpointId": { "type": "string" },
        "phaseId": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } }
      }
    },
    "deploymentResult": {
      "type": "object",
      "required": ["environment", "releaseRef", "verdict", "gaps", "risks"],
      "properties": {
        "environment": { "type": "string" },
        "releaseRef": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "risks": { "type": "array", "items": { "$ref": "#/definitions/riskFinding" } }
      }
    },
    "complianceResult": {
      "type": "object",
      "required": ["verdict", "totalChecks", "passedChecks", "failedChecks", "skippedChecks"],
      "properties": {
        "verdict": { "$ref": "#/definitions/verdict" },
        "score": { "type": "number" },
        "totalChecks": { "type": "integer" },
        "passedChecks": { "type": "integer" },
        "failedChecks": { "type": "integer" },
        "skippedChecks": { "type": "integer" }
      }
    },
    "designResult": {
      "type": "object",
      "description": "ADR-0104 design evaluation. ADVISORY/NON-BINDING; primary output is technicalMaturity (0..100).",
      "required": ["verdict", "technicalMaturity", "perConcernMaturity", "artifactStatus", "missingArtifacts", "deviationsRequiringAdr", "gaps", "recommendations"],
      "properties": {
        "verdict": { "$ref": "#/definitions/verdict" },
        "technicalMaturity": { "type": "number", "minimum": 0, "maximum": 100 },
        "perConcernMaturity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concern", "maturity", "gaps"],
            "properties": {
              "concern": { "type": "string" },
              "maturity": { "type": "number", "minimum": 0, "maximum": 100 },
              "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } }
            }
          }
        },
        "artifactStatus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifactKind", "required", "present", "verdict"],
            "properties": {
              "artifactKind": { "type": "string" },
              "required": { "type": "boolean" },
              "present": { "type": "boolean" },
              "verdict": { "$ref": "#/definitions/verdict" }
            }
          }
        },
        "missingArtifacts": { "type": "array", "items": { "type": "string" } },
        "deviationsRequiringAdr": { "type": "array", "items": { "type": "string" } },
        "gaps": { "type": "array", "items": { "$ref": "#/definitions/gapFinding" } },
        "recommendations": { "type": "array", "items": { "$ref": "#/definitions/recommendation" } },
        "downstreamCriteria": { "type": "array", "items": { "$ref": "#/definitions/recommendation" } }
      }
    }
  }
}
