set -e

echo "======================================================================"
echo "  Evolith CI Pre-commit Hook"
echo "======================================================================"

# ---------------------------------------------------------------------------
# OKF projection guard (always-on, offline, ~ms) — corre en cualquier modo,
# incluso skip. Bloquea si se stagea el bundle derivado; avisa STALE del vigia
# del estandar. Ver ADR-0105 y knowledge-okf-precommit-guard.mjs.
# ---------------------------------------------------------------------------
node .harness/scripts/knowledge-okf-precommit-guard.mjs

# ---------------------------------------------------------------------------
# Owner detection
# ---------------------------------------------------------------------------
IS_OWNER=false
OWNER_CONFIG=$(git config --global evolith.owner 2>/dev/null || echo "")
GIT_USER_EMAIL=$(git config user.email 2>/dev/null || echo "")

if [ "$OWNER_CONFIG" = "true" ] || [ "$OWNER_CONFIG" = "$GIT_USER_EMAIL" ]; then
  IS_OWNER=true
fi

# ---------------------------------------------------------------------------
# CI mode, push target, merge method detection
# ---------------------------------------------------------------------------
MODE=""
TARGET=""
MERGE_METHOD=""

# Handoff to pre-push. `.git` is a DIRECTORY only in the primary checkout; in a
# `git worktree` it is a FILE holding a `gitdir:` pointer, so writing to
# `.git/EVOLITH_*` fails with ENOTDIR and `set -e` aborts the commit.
# `--git-dir` resolves both layouts. Keep this identical to .husky/pre-push,
# which reads these files back.
GIT_DIR_PATH="$(git rev-parse --git-dir)"

write_push_intent() {
  echo "$MODE" > "$GIT_DIR_PATH/EVOLITH_CI_MODE"
  echo "$TARGET" > "$GIT_DIR_PATH/EVOLITH_PUSH_TARGET"
  echo "$MERGE_METHOD" > "$GIT_DIR_PATH/EVOLITH_MERGE_METHOD"
}

resolve_from_env() {
  MODE="${EVOLITH_CI_MODE:-skip}"
  TARGET="${EVOLITH_PUSH_TARGET:-develop}"
  MERGE_METHOD="${EVOLITH_MERGE_METHOD:-merge}"
}

TTY_AVAILABLE=false
if exec < /dev/tty 2>/dev/null; then
  TTY_AVAILABLE=true
fi

if [ "$TTY_AVAILABLE" = false ]; then
  if [ "$IS_OWNER" = true ]; then
    resolve_from_env
    write_push_intent
    echo "No TTY available — owner mode: mode=$MODE."
    # Antes se salia con exit 0 SIEMPRE, asi que ningun commit sin TTY (agente,
    # script, CI) llegaba nunca al ci-runner de la linea final. Ahora, si el
    # modo pide validacion, se ejecuta. `skip` sigue saliendo limpio: la
    # validacion de verdad la hace CI, esto es solo feedback local rapido.
    if [ "$MODE" != "skip" ]; then
      echo "Running CI in $MODE mode..."
      node .harness/scripts/ci-runner.mjs "$MODE"
    fi
    exit 0
  fi

  if [ -n "$EVOLITH_CI_MODE" ] || [ -n "$EVOLITH_PUSH_TARGET" ] || [ -n "$EVOLITH_MERGE_METHOD" ]; then
    resolve_from_env
    write_push_intent
    echo "Non-TTY: using EVOLITH_CI_MODE, EVOLITH_PUSH_TARGET, EVOLITH_MERGE_METHOD."
    exit 0
  fi

  # THIS USED TO BE `exit 1`, AND IT REJECTED THE COMMIT.
  #
  # A contributor committing from an editor, a script, an agent or any other
  # non-TTY context got their commit refused, and the remedy offered was
  # "mark yourself as owner: git config --global evolith.owner" — telling a
  # stranger to claim ownership of somebody else's repository in order to be
  # allowed to commit to their own fork.
  #
  # Nothing here is a correctness check. This hook chooses a LOCAL validation
  # mode and records a release-macro intent that only owners can act on. There
  # is nothing to fail closed about: the real gates are commit-msg (Conventional
  # Commits and DCO, both of which still run) and CI.
  #
  # So a non-owner with no TTY commits, with no push intent recorded at all.
  echo "No TTY and no owner config — committing without local validation."
  echo "  (Conventional Commits and the DCO sign-off are still checked by commit-msg.)"
  echo "  Optional: EVOLITH_CI_MODE=fast|governance|auto|full to run local checks."
  exit 0
fi

# ---------------------------------------------------------------------------
# Interactive prompt
# ---------------------------------------------------------------------------
echo ""
echo "  CI Mode:"
echo "  1) ⚡ Skip       — commit without validation (~0s)"
echo "  2) 🚀 Fast       — docs + tracking (~2s)"
echo "  3) 🏛️  Governance — docs + tracking + maturity + contracts (~3s)"
echo "  4) 🔍 Auto       — detect changed files (~1-3s)"
echo "  5) 🔬 Full       — all 30 CI scripts (~6-8s)"
echo ""

# ---------------------------------------------------------------------------
# THE BRANCH AND MERGE-METHOD PROMPTS ARE OWNER-ONLY.
#
# They record an intent that `.husky/pre-push` acts on by merging develop into
# main and pushing both. A non-owner cannot perform that and should never be
# asked to authorize it — yet the menu offered it to everyone with `d) develop`
# as the DEFAULT, so pressing Enter twice recorded an intent to push a branch
# they have no write access to, and `m) main` was one keystroke away.
#
# A contributor picks a local validation mode and nothing else. No intent is
# recorded, so pre-push has nothing to dispatch and their `git push` is theirs.
# ---------------------------------------------------------------------------
if [ "$IS_OWNER" != true ]; then
  read -p "  CI Mode [1-5, default: 1]: " CHOICE
  case "${CHOICE:-1}" in
    1) MODE="skip" ;;
    2) MODE="fast" ;;
    3) MODE="governance" ;;
    4) MODE="auto" ;;
    5) MODE="full" ;;
    *) MODE="skip" ;;
  esac

  if [ "$MODE" = "skip" ]; then
    echo ""
    echo "Skipping local validation. Your push is your own — this hook records no push intent."
    exit 0
  fi

  echo ""
  echo "Running CI in $MODE mode..."
  node .harness/scripts/ci-runner.mjs "$MODE"
  exit 0
fi

echo "  Branch:"
echo "  d) develop      — push to develop (default)"
echo "  m) main         — merge to main + push"
echo "  s) sync         — sync develop <-> main (both directions)"
echo "  n) none         — commit only, don't push"
echo ""
echo "  Merge Method (for main/sync only):"
echo "  m) merge commit — git merge --no-ff (default)"
echo "  s) squash       — git merge --squash (single commit)"
echo "  r) rebase       — git rebase + fast-forward (linear)"
echo ""

read -p "  CI Mode [1-5, default: 1]: " CHOICE
case "${CHOICE:-1}" in
  1) MODE="skip" ;;
  2) MODE="fast" ;;
  3) MODE="governance" ;;
  4) MODE="auto" ;;
  5) MODE="full" ;;
  *) MODE="skip" ;;
esac

read -p "  Branch [d/m/s/n, default: d]: " BRANCH_CHOICE
case "${BRANCH_CHOICE:-d}" in
  d) TARGET="develop" ;;
  m) TARGET="main" ;;
  s) TARGET="sync" ;;
  n) TARGET="none" ;;
  *) TARGET="develop" ;;
esac

MERGE_METHOD="merge"
if [ "$TARGET" = "main" ] || [ "$TARGET" = "sync" ]; then
  read -p "  Merge Method [m/s/r, default: m]: " MERGE_CHOICE
  case "${MERGE_CHOICE:-m}" in
    m) MERGE_METHOD="merge" ;;
    s) MERGE_METHOD="squash" ;;
    r) MERGE_METHOD="rebase" ;;
    *) MERGE_METHOD="merge" ;;
  esac
fi

write_push_intent

if [ "$MODE" = "skip" ]; then
  echo ""
  echo "Skipping CI validation."
  exit 0
fi

echo ""
echo "Generating executive governance summary..."
node .harness/scripts/generate-executive-summary.mjs
# El generador escribe en control-center/maturity-reports/. La ruta anterior
# (reference/governance/standards/vision/) desaparecio en el refactor: el
# resumen se regeneraba en cada commit y NUNCA se stageaba, asi que el guard
# 05-validate-executive-summary lo reportaba stale de forma permanente.
git add reference/core/control-center/maturity-reports/executive-summary.md \
        reference/core/control-center/maturity-reports/executive-summary.es.md

echo ""
echo "Running CI in $MODE mode..."
node .harness/scripts/ci-runner.mjs "$MODE"
