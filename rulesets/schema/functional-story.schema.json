{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/functional-story.schema.json",
  "title": "Functional Story",
  "description": "JSON Schema for validating Evolith Functional Story artifacts. Business-readable behavior specs separate from implementation.",
  "type": "object",
  "required": ["id", "title", "type", "version", "boundedContext", "actors", "businessRules", "acceptanceCriteria"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FS-\\d{3}$",
      "description": "Functional Story ID following pattern FS-XXX."
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "description": "User-facing title describing the capability in business language."
    },
    "type": {
      "type": "string",
      "enum": ["Functional", "Technical", "Enabler", "Debt"],
      "description": "Story type classification."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this story document."
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Ready", "In Progress", "Done", "Blocked"],
      "default": "Draft"
    },
    "boundedContext": {
      "type": "string",
      "description": "Domain bounded context this story belongs to."
    },
    "epic": {
      "type": "string",
      "description": "Epic or initiative this story belongs to."
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "role"],
        "additionalProperties": false,
        "properties": {
          "actor": { "type": "string" },
          "role": { "type": "string" },
          "goal": { "type": "string" }
        }
      },
      "minItems": 1,
      "description": "Primary and secondary actors interacting with this capability."
    },
    "businessRules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Invariant business rules that must always hold."
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criteria", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "criteria": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      },
      "minItems": 1,
      "description": "BDD-format acceptance criteria (Given/When/Then)."
    },
    "nonFunctionalExpectations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "expectation"],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": ["Performance", "Security", "Scalability", "Observability"]
          },
          "expectation": { "type": "string" }
        }
      },
      "description": "NFE expectations from SDLC Quality Gates that apply to this story."
    },
    "relatedADRs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ADRs that constrain or enable this story."
    },
    "technicalStories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TS-\\d{3}$" },
      "description": "Technical Story IDs that trace back to this Functional Story."
    },
    "parentPRD": {
      "type": "string",
      "description": "Parent PRD ID that authorized this story."
    }
  }
}