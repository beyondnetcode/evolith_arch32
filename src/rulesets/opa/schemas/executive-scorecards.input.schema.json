{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/executive-scorecards.input.schema.json",
  "title": "Executive Scorecards OPA Policy Input Schema",
  "type": "object",
  "required": ["satellite"],
  "properties": {
    "satellite": {
      "type": "object",
      "required": ["scorecards"],
      "properties": {
        "scorecards": {
          "type": "object",
          "required": [
            "deploymentFrequencyDeclared",
            "leadTimeDeclared",
            "changeFailureRateDeclared",
            "timeToRestoreDeclared",
            "observabilityOperational",
            "executiveSponsorAssigned",
            "architectureDriftIndex"
          ],
          "properties": {
            "deploymentFrequencyDeclared": { "type": "boolean" },
            "leadTimeDeclared": { "type": "boolean" },
            "changeFailureRateDeclared": { "type": "boolean" },
            "timeToRestoreDeclared": { "type": "boolean" },
            "observabilityOperational": { "type": "boolean" },
            "executiveSponsorAssigned": { "type": "boolean" },
            "architectureDriftIndex": { "type": "number" }
          }
        }
      }
    }
  }
}
