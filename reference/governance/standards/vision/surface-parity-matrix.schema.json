{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Surface Parity Matrix Schema",
  "description": "Schema for the machine-readable surface-parity matrix used by GT-171. Validates structure of operations and their surface exposure status.",
  "type": "object",
  "required": ["version", "operations"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the matrix format"
    },
    "description": { "type": "string" },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of last review in YYYY-MM-DD format"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "cli", "mcp", "rest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$",
            "description": "Unique operation identifier (kebab-case)"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "cli": {
            "type": "object",
            "required": ["exposed"],
            "properties": {
              "exposed": { "type": "boolean" },
              "command": { "type": "string" },
              "exempt": { "type": "string" }
            }
          },
          "mcp": {
            "type": "object",
            "required": ["exposed"],
            "properties": {
              "exposed": { "type": "boolean" },
              "tool": { "type": "string" },
              "exempt": { "type": "string" }
            }
          },
          "rest": {
            "type": "object",
            "required": ["exposed"],
            "properties": {
              "exposed": { "type": "boolean" },
              "endpoint": { "type": "string" },
              "exempt": { "type": "string" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "cli": { "properties": { "exposed": { "const": true } } } } },
            "then": { "properties": { "cli": { "required": ["command"] } } }
          },
          {
            "if": { "properties": { "cli": { "properties": { "exposed": { "const": false } } } } },
            "then": { "properties": { "cli": { "required": ["exempt"] } } }
          },
          {
            "if": { "properties": { "mcp": { "properties": { "exposed": { "const": true } } } } },
            "then": { "properties": { "mcp": { "required": ["tool"] } } }
          },
          {
            "if": { "properties": { "mcp": { "properties": { "exposed": { "const": false } } } } },
            "then": { "properties": { "mcp": { "required": ["exempt"] } } }
          },
          {
            "if": { "properties": { "rest": { "properties": { "exposed": { "const": true } } } } },
            "then": { "properties": { "rest": { "required": ["endpoint"] } } }
          },
          {
            "if": { "properties": { "rest": { "properties": { "exposed": { "const": false } } } } },
            "then": { "properties": { "rest": { "required": ["exempt"] } } }
          }
        ]
      }
    }
  }
}
