{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/knowledge-intake.input.schema.json",
  "title": "Knowledge Intake OPA Policy Input Schema",
  "type": "object",
  "required": ["knowledge_id", "source", "assessment", "promotion", "review", "synthesis"],
  "properties": {
    "knowledge_id": { "type": "string", "pattern": "^KI-[A-Z0-9-]+$" },
    "source_registry_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
    "source": {
      "type": "object",
      "required": ["class", "locator", "retrieved_at", "rights_status"],
      "properties": {
        "class": { "enum": ["book", "public-article", "official-docs"] },
        "author": { "type": "string" },
        "work": { "type": "string" },
        "locator": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "rights_status": { "enum": ["citation-and-synthesis-only", "public-reference", "official-documentation"] }
      }
    },
    "assessment": {
      "type": "object",
      "required": ["maturity", "preconditions", "anti_patterns", "alternatives"],
      "properties": {
        "maturity": { "enum": ["standard", "emerging", "proven", "speculative"] },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "anti_patterns": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "promotion": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["candidate", "evaluated", "accepted", "executable", "retired"] },
        "promoted_at": { "type": ["string", "null"] },
        "promoted_by": { "type": ["string", "null"] },
        "adr": { "type": ["string", "null"] },
        "native_rule": { "type": ["string", "null"] },
        "opa_policy": { "type": ["string", "null"] },
        "fixtures": { "type": "array", "items": { "type": "string" } },
        "disposition": { "type": ["string", "null"] }
      }
    },
    "review": {
      "type": "object",
      "required": ["owner", "next_review_at", "review_freshness"],
      "properties": {
        "owner": { "type": "string" },
        "next_review_at": { "type": "string" },
        "review_freshness": { "type": "string" }
      }
    },
    "synthesis": { "type": "string" }
  }
}
