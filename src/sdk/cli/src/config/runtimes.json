  "monorepoOptions": [
    {
      "id": "none",
      "name": "None",
      "description": "Monolito simple - un solo paquete",
      "defaults": {
        "structure": "single",
        "ciStrategy": "monolithic"
      }
    },
    {
      "id": "nx",
      "name": "Nx",
      "description": "Nx - Graph de dependencias, CI optimizado, affected builds",
      "frameworks": [
        "nestjs",
        "typescript"
      ],
      "defaults": {
        "structure": "monorepo",
        "ciStrategy": "affected",
        "libraryStructure": "strict"
      }
    },
    {
      "id": "npm-workspaces",
      "name": "NPM Workspaces",
      "description": "NPM Workspaces - simple, flat, no overhead",
      "frameworks": [
        "nodejs",
        "typescript"
      ],
      "defaults": {
        "structure": "monorepo",
        "ciStrategy": "monolithic"
      }
    },
    {
      "id": "pnpm-workspaces",
      "name": "PNPM Workspaces",
      "description": "PNPM - Efectivo en espacio, fast installs",
      "frameworks": [
        "nodejs",
        "typescript"
      ],
      "defaults": {
        "structure": "monorepo",
        "ciStrategy": "monolithic"
      }
    },
    {
      "id": "rush",
      "name": "Rush",
      "description": "Rush - enterprise, with policy enforcement",
      "frameworks": [
        "nodejs",
        "typescript"
      ],
      "defaults": {
        "structure": "monorepo",
        "ciStrategy": "incremental",
        "policyEnforcement": true
      }
    }
