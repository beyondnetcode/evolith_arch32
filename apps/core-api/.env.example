# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Authentication (ApiKeyGuard) ─────────────────────────────────────────────
# When EVOLITH_API_KEY is set, all routes except health require it via
# `Authorization: Bearer <key>` or `x-api-key: <key>`. When unset, the API stays
# open (migration-safe) — set it to enforce. CORE_API_AUTH_REQUIRED=true forces
# fail-closed even with no key configured.
EVOLITH_API_KEY=
CORE_API_AUTH_REQUIRED=false

# ─── Paths ───────────────────────────────────────────────────────────────────
# Ruta absoluta al repositorio Evolith Core (debe contener rulesets/ y reference/)
CORE_PATH=/absolute/path/to/evolith

# Directorio raíz donde el Tracker BFF monta los workspaces de los tenants
WORKSPACE_ROOT=/var/run/evolith/workspaces

# ─── CORS ────────────────────────────────────────────────────────────────────
# En development se permite '*' automáticamente. En production, especificar
# orígenes explícitos como CSV:
# CORS_ORIGINS=https://tracker.evolith.io,https://app.evolith.io
CORS_ORIGINS=

# ─── Swagger ─────────────────────────────────────────────────────────────────
# En development la UI siempre está disponible en /api/docs.
# En production, setear a "true" para habilitarla explícitamente.
SWAGGER_ENABLED=false

# ─── Redis (opcional) ────────────────────────────────────────────────────────
# La caché degrada gracefulmente si Redis no está disponible.
# REDIS_URL tiene prioridad sobre REDIS_HOST/PORT/PASSWORD.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
