# Agent Runtime Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Engine Routing ───────────────────────────────────────────────
MIN_TOKEN_BUDGET=1000              # Min tokens before routing to stub engine (default: 1000)

# ─── Agent Runtime API Connection ────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:3000  # Agent Runtime API URL

# ─── LLM Network Egress (GT-575) ─────────────────────────────────
# DEFAULT STATE: OFF. With EVOLITH_LLM_EGRESS unset, GeminiProvider refuses to
# open a socket and throws LlmEgressDisabledError; nothing leaves the process.
# Setting it to `true` (or `1`) is the ONLY implicit way to arm egress; code may
# also pass `new GeminiProvider({ enabled: true })` explicitly.
#
# When armed, the runtime performs an outbound HTTPS POST to
#   https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
# (sub-processor: Google LLC). What leaves: the system prompt, the request
# intent/tool/parameters and the governed skill catalog — secret-redacted and
# capped by a byte/token budget. What does NOT leave: tenant, product,
# initiative and workspace references. The credential travels in the
# `x-goog-api-key` header, never in the URL. Every attempt (including refusals)
# emits an `[evolith:llm-egress]` audit record with aggregate telemetry only.
# EVOLITH_LLM_EGRESS=true
# EVOLITH_LLM_API_KEY=                   # preferred credential var (falls back to GEMINI_API_KEY)
