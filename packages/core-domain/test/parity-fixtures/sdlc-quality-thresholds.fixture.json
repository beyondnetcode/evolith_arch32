          "/sat/otel.config.js",
          "/sat/contracts"
        ],
        "dirs": {
          "/sat/coverage": ["lcov.info"],
          "/sat/docs": ["api.md"],
          "/sat/contracts": ["service.proto"]
        },
        "files": {}
      },
      "context": { "satellitePath": "/sat", "corePath": "/core" },
      "expectedResults": [
        { "ruleId": "QT-01", "result": "passed" },
