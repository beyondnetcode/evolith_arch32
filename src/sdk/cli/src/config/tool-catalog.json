      "defaultTools": [
        "jaeger",
        "prometheus",
        "loki",
        "grafana",
        "otel-collector",
        "dora-metrics"
      ]
    }
  },
  "toolMetadata": {
    "acl-schema-validator": {
      "description": "Valida datos externos contra esquemas Core",
      "runtimeAgnostic": true,
      "phase": "phase-2"
    },
    "adr-create": {
      "description": "Generates ADR templates and commands",
      "runtimeAgnostic": true,
      "phase": "phase-3"
    },
    "context-mapper": {
      "description": "Define and document bounded contexts",
      "runtimeAgnostic": true,
      "phase": "phase-3"
    },
    "dockerfile-generator": {
      "description": "Generates a Dockerfile optimised per runtime",
      "runtimeAware": true,
      "phase": "phase-4"
    },
    "otel-instrumentation": {
      "description": "OpenTelemetry instrumentation",
      "runtimeAware": true,
      "phase": "phase-4"
    },
    "dora-metrics": {
      "description": "Automatic DORA metrics collection",
      "runtimeAgnostic": true,
      "phase": "phase-5"
    }
  }
}
