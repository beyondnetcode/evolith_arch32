{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/mcp.input.schema.json",
  "title": "MCP OPA Policy Input Schema",
  "type": "object",
  "required": ["core"],
  "properties": {
    "core": {
      "type": "object",
      "required": ["evidence", "cli"],
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "results": {
                "type": "object",
                "properties": {
                  "initialize": { "type": "object" },
                  "tools/list": { "type": "object" },
                  "resources/list": { "type": "object" }
                }
              }
            }
          }
        },
        "cli": {
          "type": "object",
          "required": ["mcpServerSource"],
          "properties": {
            "mcpServerSource": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
