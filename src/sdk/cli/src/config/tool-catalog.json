          ],
          "tools": [
            "grafana-server",
            "datasource-config",
            "dashboard-templates"
          ]
        },
        "alerting": {
          "question": "Alerting?",
          "defaultOption": "grafana-alerts",
          "options": [
            {
              "value": "grafana-alerts",
