      ],
      "classification": "advisory"
    },
    {
      "id": "ci-pipeline-result",
      "label": "CI Pipeline",
      "phases": [
        "construction"
      ],
      "classification": "binding",
      "producedBy": {
        "format": "provider-native",
        "note": "The CI providers native run record (GitHub Actions run, GitLab job). Evolith reads the verdict and the run URL; inventing a schema here would restate what the provider already publishes and rot when it changes."
      }
    },
    {
      "id": "contract-test-result",
      "label": "Contract Test Result",
      "phases": [
        "quality"
      ],
      "classification": "advisory"
    },
    {
      "id": "coverage-report",
      "label": "Coverage Report",
      "phases": [
        "construction",
        "quality"
      ],
      "classification": "binding",
      "producedBy": {
        "format": "cobertura|lcov|jacoco",
        "note": "Emitted by the coverage tool in its own long-standing format. A bespoke schema would force a lossy translation of something every reader already parses."
      }
    },
