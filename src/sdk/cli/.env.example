# CLI Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Command Execution ────────────────────────────────────────────
CLI_COMMAND_TIMEOUT_MS=120000     # Command execution timeout (default: 120000 = 2 min)

# ─── History ──────────────────────────────────────────────────────
CLI_HISTORY_DEFAULT_LIMIT=20      # Default history page size (default: 20)

# ─── Core API Connection ─────────────────────────────────────────
EVOLITH_CORE_URL=http://localhost:3000  # Core API URL for remote operations

# ─── Agent Runtime Connection ─────────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:3000  # Agent Runtime URL

# ─── GitHub ───────────────────────────────────────────────────────
GITHUB_TOKEN=                     # GitHub personal access token (preferred over --token flag)

# ─── SDK Client ───────────────────────────────────────────────────
EVOLITH_API_TIMEOUT_MS=30000      # SDK client request timeout (default: 30000 = 30s)
