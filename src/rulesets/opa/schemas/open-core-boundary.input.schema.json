{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/open-core-boundary.input.schema.json",
  "title": "Open-Core Boundary OPA Policy Input Schema",
  "type": "object",
  "required": [
    "satellite"
  ],
  "properties": {
    "satellite": {
      "type": "object",
      "required": [
        "openCore"
      ],
      "properties": {
        "openCore": {
          "type": "object",
          "required": [
            "coreHasEnterpriseReferences",
            "enterpriseArtifactNotMarked",
            "aclImplementationInCore",
            "cliMcpGated",
            "trackerConceptsInCore",
            "tieredAccessInCore",
            "coreRequiresEnterprise"
          ],
          "properties": {
            "coreHasEnterpriseReferences": {
              "type": "boolean"
            },
            "enterpriseArtifactNotMarked": {
              "type": "boolean"
            },
            "aclImplementationInCore": {
              "type": "boolean"
            },
            "cliMcpGated": {
              "type": "boolean"
            },
            "trackerConceptsInCore": {
              "type": "boolean"
            },
            "tieredAccessInCore": {
              "type": "boolean"
            },
            "coreRequiresEnterprise": {
              "type": "boolean"
            },
            "hasEnterprisePromotionWithoutApproval": {
              "type": "boolean",
              "description": "Read by open-core-boundary.rego. Declared by GT-695."
            }
          }
        }
      }
    }
  }
}
