{
  "name": "@evolith/mcp-server",
  "version": "1.0.0",
  "description": "Evolith MCP Gateway — NestJS-based Model Context Protocol server for AI agents. Supports stdio and SSE transports.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "evolith-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "build:dev": "nest build --watch",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:stdio": "TRANSPORT=stdio node dist/main",
    "start:sse": "TRANSPORT=sse PORT=3000 node dist/main",
    "lint:boundaries": "eslint \"src/**/*.ts\" --no-eslintrc -c .eslintrc.js",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "evolith",
    "mcp",
    "model-context-protocol",
    "nestjs",
    "ai-agents",
    "gateway",
    "governance"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@evolith/core": "1.0.0",
    "@evolith/core-domain": "1.0.4",
    "@evolith/infra-providers": "1.0.2",
    "fs-extra": "10.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "cache-manager": "7.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "yaml": "1.10.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.0.0",
    "@types/fs-extra": "11.0.4",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/parser": "*",
    "eslint": "*",
    "eslint-plugin-boundaries": "*",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
