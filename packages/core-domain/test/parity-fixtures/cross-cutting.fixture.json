{
  "domain": "cross-cutting",
  "description": "Cross-cutting rule evaluator parity — DOD, EM, CB, TAX rules",
  "rules": [
    { "id": "DOD-01", "severity": "MUST", "category": "definition-of-done", "title": "CI Workflow for PRs", "description": "CI must have a workflow triggered on pull requests", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-02", "severity": "MUST", "category": "definition-of-done", "title": "Test Coverage Evidence", "description": "Coverage report must be present", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-03", "severity": "MUST", "category": "definition-of-done", "title": "Test Infrastructure", "description": "Test framework must be configured", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-04", "severity": "MUST", "category": "definition-of-done", "title": "Documentation", "description": "Documentation artifacts must exist", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-05", "severity": "MUST", "category": "definition-of-done", "title": "Observability", "description": "Observability instrumentation must be present", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-06", "severity": "MUST", "category": "definition-of-done", "title": "Security CI Workflow", "description": "CI must have a security scan workflow", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-07", "severity": "MUST", "category": "definition-of-done", "title": "ADR Directory", "description": "ADR directory must exist", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-08", "severity": "MUST", "category": "definition-of-done", "title": "Integration Tests", "description": "Integration tests directory must exist", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-09", "severity": "MUST", "category": "definition-of-done", "title": "Lint CI Workflow", "description": "CI must have a lint workflow", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "DOD-10", "severity": "MUST", "category": "definition-of-done", "title": "CI Configuration", "description": "CI configuration files must exist", "blocking": true, "sourceFile": "definition-of-done.rules.json" },
    { "id": "EM-S-03", "severity": "MUST", "category": "engineering-manifesto", "title": "ESLint Config (SOLID)", "description": "ESLint configuration must exist", "blocking": true, "sourceFile": "engineering-manifesto.rules.json" },
    { "id": "EM-S-05", "severity": "MUST", "category": "engineering-manifesto", "title": "ESLint Config (SRP)", "description": "ESLint configuration must exist for single responsibility", "blocking": true, "sourceFile": "engineering-manifesto.rules.json" },
    { "id": "EM-K-01", "severity": "MUST", "category": "engineering-manifesto", "title": "ESLint Config (KISS)", "description": "ESLint configuration must exist for simplicity", "blocking": true, "sourceFile": "engineering-manifesto.rules.json" },
    { "id": "EM-Y-01", "severity": "MUST", "category": "engineering-manifesto", "title": "YAGNI Coverage", "description": "Test coverage must support YAGNI principle", "blocking": true, "sourceFile": "engineering-manifesto.rules.json" },
    { "id": "CB-01", "severity": "MUST", "category": "compliance-baseline", "title": "Satellite Config", "description": "Satellite must have evolith.yaml for compliance baseline", "blocking": true, "sourceFile": "compliance-baseline.rules.json" },
    { "id": "CB-VAL-01", "severity": "MUST", "category": "compliance-baseline", "title": "Compliance Pillar", "description": "evolith.yaml must contain spec.compliance section", "blocking": true, "sourceFile": "compliance-baseline.rules.json" },
    { "id": "CB-VAL-02", "severity": "SHOULD", "category": "compliance-baseline", "title": "Baseline Reference", "description": "Baseline reference validation requires document resolution", "blocking": false, "sourceFile": "compliance-baseline.rules.json" },
    { "id": "TAX-01", "severity": "MUST", "category": "repository-taxonomy", "title": "File Naming Convention", "description": "Source files must use kebab-case naming", "blocking": true, "sourceFile": "repository-taxonomy.rules.json" },
    { "id": "TAX-02", "severity": "MUST", "category": "repository-taxonomy", "title": "Type Naming (PascalCase)", "description": "Types must use PascalCase", "blocking": true, "sourceFile": "repository-taxonomy.rules.json" },
    { "id": "TAX-09", "severity": "MUST", "category": "repository-taxonomy", "title": "Reference Directory", "description": "reference/ directory must exist in core", "blocking": true, "sourceFile": "repository-taxonomy.rules.json" },
    { "id": "TAX-10", "severity": "MUST NOT", "category": "repository-taxonomy", "title": "No Product in Reference", "description": "Product artifacts must not appear in reference/", "blocking": true, "sourceFile": "repository-taxonomy.rules.json" },
    { "id": "TAX-11", "severity": "MUST NOT", "category": "repository-taxonomy", "title": "No Root Topologies", "description": "Root-level /topologies/ directory is prohibited", "blocking": true, "sourceFile": "repository-taxonomy.rules.json" }
  ],
