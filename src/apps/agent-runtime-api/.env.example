# Agent Runtime API Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000        # Rate limit window in milliseconds (default: 60000 = 1 min)
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window per IP (default: 100)

# ─── Workspace Limits ─────────────────────────────────────────────
WORKSPACE_MAX_FILES=800           # Max files to ingest from satellite corpus (default: 800)
WORKSPACE_MAX_FILE_BYTES=524288   # Max bytes per single file (default: 524288 = 512 KB)
WORKSPACE_MAX_TOTAL_BYTES=8388608 # Max total bytes ingested (default: 8388608 = 8 MB)

# ─── Auth ─────────────────────────────────────────────────────────
AGENT_RUNTIME_API_KEY=            # API key for Agent Runtime authentication
AGENT_RUNTIME_JWT_SECRET=         # JWT secret for token validation
AGENT_RUNTIME_ALLOW_NO_AUTH=false # Allow unauthenticated access (default: false)
NODE_ENV=production               # Environment: development | production

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=                     # Comma-separated allowed origins (empty = deny all)

# ─── Core API Connection ─────────────────────────────────────────
CORE_API_URL=http://localhost:3000  # Core API URL for governance queries

# ─── Knowledge / RAG ──────────────────────────────────────────────
KNOWLEDGE_TEXT_PREVIEW_LENGTH=120   # Text preview length in characters (default: 120)

# ─── Sandbox ──────────────────────────────────────────────────────
SANDBOX_TIMEOUT_MS=120000         # Sandbox execution timeout (default: 120000 = 2 min)
