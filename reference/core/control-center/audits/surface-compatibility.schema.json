{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/surface-compatibility.schema.json",
  "title": "Surface Compatibility Matrix",
  "description": "JSON Schema for the ADR-0073 envelope producer/consumer compatibility matrix (GT-174). Each surface declares the envelope schemaVersion(s) it currently produces and the consumer schemaVersion ranges it accepts. Every multi-version produces list MUST be accompanied by an explicit migration entry per consecutive version transition.",
  "type": "object",
  "required": ["version", "surfaces", "migrations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "lastReviewed": { "type": "string", "format": "date" },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["module", "constant", "produces", "consumes"],
        "additionalProperties": false,
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "constant": { "type": "string", "minLength": 1 },
          "produces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          },
          "consumes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "description": "Semver range expression (e.g. '1.x', '1.0.0 - 1.5.0') describing accepted consumer envelopes." }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "from", "to", "summary"],
        "additionalProperties": false,
        "properties": {
          "surface": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "to": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "summary": { "type": "string", "minLength": 1 },
          "addedAt": { "type": "string", "format": "date" },
          "compatibility": { "type": "string", "enum": ["compatible", "breaking"] }
        }
      }
    }
  }
}
