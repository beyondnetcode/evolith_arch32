{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/rulesets/schema/blueprint.schema.json",
  "title": "Evolith Blueprint Schema",
  "description": "Defines a reusable project blueprint — a parametrizable template that combines a topology, SDLC phase profile, and default ruleset configuration.",
  "type": "object",
  "required": ["blueprintId", "name", "topology", "phase", "version"],
  "properties": {
    "blueprintId": { "type": "string", "description": "Unique blueprint ID, e.g. nestjs-hexagonal-f2" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "topology": {
      "type": "string",
      "enum": ["modular-monolith", "distributed-modules", "microservices", "serverless", "edge-computing", "event-driven", "data-mesh", "agentic-ai"]
    },
    "phase": { "type": "integer", "minimum": 1, "maximum": 5 },
    "runtime": { "type": "string", "examples": ["nodejs", "dotnet", "java", "python"] },
    "architecture": { "type": "string", "examples": ["hexagonal", "clean", "layered", "cqrs"] },
    "rulesets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ruleset $ids that apply to projects using this blueprint"
    },
    "parameters": {
      "type": "object",
      "description": "Parametrizable variables for this blueprint (e.g. database, api-protocol)",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "default": {},
          "enum": { "type": "array" }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ADR IDs that this blueprint mandates"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "deprecated"]
    }
  },
  "additionalProperties": false
}
