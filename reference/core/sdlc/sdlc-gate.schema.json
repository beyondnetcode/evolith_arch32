{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/sdlc/sdlc-gate.schema.json",
  "title": "SDLC Gate",
  "description": "Schema for an Evolith SDLC gate data file",
  "type": "object",
  "required": ["id", "name", "phase", "description", "requiredArtifacts", "blockingCriteria"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^gate-f[1-5]$" },
    "name": { "type": "string" },
    "phase": { "type": "string", "pattern": "^f[1-5]$" },
    "description": { "type": "string" },
    "playbookRef": { "type": "string" },
    "accountableRole": { "type": "string" },
    "waiverAuthority": { "type": "string" },
    "requiredArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "validation", "rules"],
        "properties": {
          "artifact": { "type": "string" },
          "schemaRef": { "type": "string" },
          "validation": { "type": "string" },
          "rules": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "blockingCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "action"],
        "properties": {
          "criterion": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    }
  }
}
