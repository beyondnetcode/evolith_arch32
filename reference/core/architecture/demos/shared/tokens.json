{
  "$comment": "Single source of every colour, font, radius, shadow, duration and easing used by the two GitHub Pages views. build-pages.mjs writes tokens.css from it (tracked next to this file; --check fails when it drifts) and hands the light palette to the poster generator. Contrast ratios were measured for the pairs the spec lists (design-spec.md §1.2).",
  "fonts": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
    "poster": "'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
  },
  "color": {
    "light": {
      "bg": "#F4F6F8", "surface": "#FFFFFF", "surface-2": "#EEF2F5",
      "ink": "#14212E", "ink-2": "#3D4E5F", "ink-3": "#5B6B7B", "line": "#C9D3DC",
      "accent": "#B45309", "accent-soft": "#FEF3C7", "accent-ink": "#7C2D12",
      "link": "#0B5FA5", "focus": "#1D4ED8", "danger": "#B42318",
      "ok": "#15803D", "warn": "#B45309", "bad": "#B91C1C",
      "dim": "rgba(244,246,248,.72)"
    },
    "dark": {
      "bg": "#0F161D", "surface": "#161F28", "surface-2": "#1E2933",
      "ink": "#E6EDF3", "ink-2": "#B7C4D0", "ink-3": "#8B9BAB", "line": "#33414F",
      "accent": "#FBBF24", "accent-soft": "#3A2A0A", "accent-ink": "#1A1204",
      "link": "#7CC0FF", "focus": "#93C5FD", "danger": "#FCA5A5",
