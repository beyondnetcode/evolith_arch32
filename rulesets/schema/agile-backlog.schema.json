{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/agile-backlog.schema.json",
  "title": "Agile Backlog",
  "description": "JSON Schema for validating Evolith Agile Backlog artifacts. Grouped, prioritized, and versioned user stories for an Epic or Initiative.",
  "type": "object",
  "required": ["epicName", "productOwner", "items"],
  "additionalProperties": false,
  "properties": {
    "epicName": {
      "type": "string",
      "minLength": 5,
      "description": "Name of the Epic or Initiative this backlog belongs to."
    },
    "epicId": {
      "type": "string",
      "description": "Formal Epic identifier."
    },
    "productOwner": {
      "type": "string",
      "description": "Name of the accountable Product Owner."
    },
    "status": {
      "type": "string",
      "enum": ["Draft", "Refined", "In Execution", "Completed"],
      "default": "Draft"
    },
    "sprint": {
      "type": "integer",
      "description": "Current sprint number."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "priority", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(US|TS|EN|DEBT)-\\d{3}$"
          },
          "type": {
            "type": "string",
            "enum": ["Functional", "Technical", "Enabler", "Debt"]
          },
          "title": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": ["S", "M", "L", "XL"]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Priority: 1 = highest."
          },
          "status": {
            "type": "string",
            "enum": ["Draft", "Ready", "In Progress", "Done", "Blocked"]
          },
          "sprint": {
            "type": "integer",
            "description": "Sprint where this item is planned or completed."
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of stories this item depends on."
          }
        }
      },
      "minItems": 1,
      "description": "Prioritized list of backlog items."
    },
    "velocity": {
      "type": "number",
      "description": "Current team velocity (story points per sprint)."
    },
    "totalPoints": {
      "type": "number",
      "description": "Total story points in this backlog."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    }
  }
}