{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evolith Project Configuration",
  "description": "Configuration file for evolith validate command (GT-312)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "topology": {
      "type": "string",
      "enum": ["modular-monolith", "distributed-modules", "microservices", "serverless", "edge-computing", "event-driven", "data-mesh", "agentic-ai"],
      "description": "Architecture topology for validation"
    },
    "phase": {
      "type": "string",
      "enum": ["f1", "f2", "f3", "f4", "f5"],
      "description": "Current SDLC phase"
    },
    "rulesets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["acl", "open-core", "inheritance", "satellite-contracts", "executive-scorecards", "cli-release", "cli-parity", "evidence", "mcp", "observability", "compliance-baseline", "definition-of-done", "engineering-manifesto", "repository-taxonomy", "phase-gates", "quality-thresholds", "dependency-pinning"]
      },
      "description": "Rulesets to validate against"
    },
    "adrRules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["adr-0002", "adr-0005", "adr-0010", "adr-0018", "adr-0032", "adr-0040", "adr-0050"]
      },
      "description": "ADR rules to validate against"
    },
    "engine": {
      "type": "string",
      "enum": ["native", "opa"],
      "description": "Validation engine to use",
      "default": "native"
    },
    "validation": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["sdlc", "architecture", "ruleset", "adr", "adhoc"]
          },
          "description": "Default validation modes to run"
        },
        "parallel": {
          "type": "boolean",
          "description": "Execute modes in parallel for performance",
          "default": true
        },
        "timeout": {
          "type": "number",
          "description": "Timeout in milliseconds for validation",
          "default": 2000
        }
      }
    }
  },
  "additionalProperties": false
}
