{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/knowledge-intake.schema.json",
  "title": "Knowledge Intake Candidate (external KI-* or emergent KO-*)",
  "type": "object",
  "required": [
    "knowledge_id",
    "assessment",
    "promotion",
    "review",
    "synthesis"
  ],
  "properties": {
    "knowledge_id": {
      "type": "string",
      "pattern": "^(KI|KO)-[A-Z0-9-]+$"
    },
    "source_registry_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "source": {
      "type": "object",
      "required": [
        "class",
        "author",
        "work",
        "locator",
        "retrieved_at",
        "rights_status"
      ],
      "properties": {
        "class": {
          "enum": [
            "book",
            "public-article",
            "official-docs"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "rights_status": {
          "enum": [
            "citation-and-synthesis-only",
            "public-reference",
            "official-documentation"
          ]
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "trust_level",
        "portability",
        "topologies",
        "maturity",
        "concerns"
      ],
      "properties": {
        "trust_level": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "portability": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "topologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "maturity": {
          "enum": [
            "standard",
            "emerging",
            "proven",
            "speculative"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_topologies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "concerns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "evaluated",
            "accepted",
            "executable",
            "retired"
          ]
        },
        "promoted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "promoted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "adr": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "opa_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "owner",
        "next_review_at",
        "review_freshness"
      ],
      "properties": {
        "owner": {
          "const": "@winston"
        },
        "next_review_at": {
          "type": "string",
          "format": "date"
        },
        "review_freshness": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "synthesis": {
      "type": "string",
      "minLength": 40,
      "maxLength": 3000
    },
    "origin": {
      "type": "object",
      "description": "ADR-0115 — where an emergent finding was observed. Replaces `source` for KO-* records.",
      "additionalProperties": false,
      "required": [
        "class",
        "repository",
        "detected_by",
        "detected_at",
        "sensitivity"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "violation",
            "interpretation",
            "exception",
            "review-decision",
            "recurrence",
            "incident"
          ],
          "description": "What kind of observation produced this. Drives which knowledge type the entry is likely to become."
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Core or satellite repository where it was observed."
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete component, class or module involved."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "detected_by": {
          "type": "string",
          "minLength": 1,
          "description": "Agent or person that detected it, e.g. @winston-architect."
        },
        "detected_at": {
          "type": "string",
          "format": "date"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "description": "ADR-0115 exclusions — governs what may be published. `restricted` never reaches shared knowledge."
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Evidence.provenance.artifactHash (ADR-0111) backing the observation."
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "How many times observed; the recurrence signal."
        }
      }
    }
  },
  "additionalProperties": false,
  "description": "ADR-0097 governs the lifecycle; ADR-0115 adds the emergent origin. A record carries EITHER a `source` block (external work, KI-*) OR an `origin` block (observation made applying the standard, KO-*) — never both. Everything downstream of the origin (assessment, promotion, review, synthesis) is deliberately identical so the two share one set of promotion gates.",
  "oneOf": [
    {
      "title": "External intake (KI-*)",
      "properties": {
        "knowledge_id": {
          "pattern": "^KI-[A-Z0-9-]+$"
        }
      },
      "required": [
        "source",
        "source_registry_id"
      ],
      "not": {
        "required": [
          "origin"
        ]
      }
    },
    {
      "title": "Emergent intake (KO-*)",
      "properties": {
        "knowledge_id": {
          "pattern": "^KO-[A-Z0-9-]+$"
        }
      },
      "required": [
        "origin"
      ],
      "allOf": [
        {
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "not": {
            "required": [
              "source_registry_id"
            ]
          }
        }
      ]
    }
  ]
}
