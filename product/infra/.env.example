# =============================================================================
# Docker Compose Environment Variables — Evolith Infrastructure
# =============================================================================
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env with real credentials to version control.
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=changeme

# SQL Server (SA password — min 8 chars, must meet MSSQL complexity)
MSSQL_SA_PASSWORD=changeme

# MongoDB
MONGO_PASSWORD=changeme

# Redis
REDIS_PASSWORD=changeme

# RabbitMQ
RABBITMQ_PASSWORD=changeme

# MinIO (S3-compatible object storage)
MINIO_ROOT_PASSWORD=changeme

# OpenBao (Vault-compatible secrets management)
BAO_DEV_ROOT_TOKEN=changeme

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme
