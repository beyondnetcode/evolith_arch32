{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/phase-gates.input.schema.json",
  "title": "Phase Gates OPA Policy Input Schema",
  "description": "Input for evolith.phase_gates. All fields optional at the OPA layer: when `gate` is absent the policy yields no violations (additive aggregation in evolith.main). GT-380 / L1c.",
  "type": "object",
  "properties": {
    "gate": {
      "type": "object",
      "properties": {
        "phase": { "type": "integer", "description": "SDLC phase order (legacy numeric; canonical phaseId carried in EvaluationContext)." },
        "mandatoryEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact"],
            "properties": { "artifact": { "type": "string" } }
          }
        },
        "blockingCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion"],
            "properties": { "criterion": { "type": "string" } }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact"],
        "properties": {
          "artifact": { "type": "string" },
          "status": { "type": "string" },
          "approvalEvidence": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "waiver": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "properties": {
          "criterion": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "expired", "revoked"] },
          "expirationDate": { "type": "string" }
        }
      }
    },
    "tenantId": { "type": "string", "description": "Opaque context identifier (audit trail only)." },
    "evaluationDate": { "type": "string", "description": "ISO-8601 date used for waiver-expiry comparison." }
  }
}
