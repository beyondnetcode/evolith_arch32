# Core API Environment Variables
# Copy this file to .env and adjust values as needed.

# ─── Rate Limiting ────────────────────────────────────────────────
THROTTLE_TTL_MS=60000             # Throttler TTL in milliseconds (default: 60000 = 1 min)
THROTTLE_MAX_REQUESTS=100         # Max requests per TTL window (default: 100)

# ─── Cache ────────────────────────────────────────────────────────
REDIS_CACHE_TTL_MS=300000         # Redis cache TTL in milliseconds (default: 300000 = 5 min)
REDIS_CACHE_MAX_ENTRIES=1000      # Redis cache max entries (default: 1000)

# ─── Circuit Breaker ─────────────────────────────────────────────
CIRCUIT_BREAKER_TIMEOUT_MS=10000          # Per-call timeout (default: 10000 = 10s)
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000    # Reset timeout (default: 30000 = 30s)
CIRCUIT_BREAKER_ERROR_THRESHOLD_PCT=50    # Error threshold percentage (default: 50)

# ─── Command History ─────────────────────────────────────────────
COMMAND_HISTORY_MAX_ENTRIES=1000          # Max history entries (default: 1000)
COMMAND_HISTORY_DEFAULT_LIMIT=50          # Default query page size (default: 50)
COMMAND_HISTORY_RECENT_WINDOW_MS=86400000 # "Recent" window in ms (default: 86400000 = 24h)

# ─── Auth ─────────────────────────────────────────────────────────
EVOLITH_API_KEY=                  # API key for Core API authentication
CORE_API_AUTH_REQUIRED=true       # Fail-closed: reject unauthenticated requests (default: true)
DAPR_HTTP_PORT=3500               # Dapr sidecar port for secret fetch (default: 3500)
NODE_ENV=production               # Environment: development | production

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=                     # Comma-separated allowed origins (empty = deny all)

# ─── Swagger ──────────────────────────────────────────────────────
SWAGGER_ENABLED=false             # Enable Swagger UI (default: false, requires explicit opt-in)

# ─── Workspace ────────────────────────────────────────────────────
WORKSPACE_ROOT=                   # Root directory for satellite resolution
CORE_PATH=                        # Path to Evolith Core repository
