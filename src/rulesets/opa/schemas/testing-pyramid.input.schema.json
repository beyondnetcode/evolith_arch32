{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/testing-pyramid.input.schema.json",
  "title": "Testing Pyramid OPA Policy Input Schema",
  "type": "object",
  "required": [
    "satellite"
  ],
  "properties": {
    "satellite": {
      "type": "object",
      "required": [
        "testing"
      ],
      "properties": {
        "testing": {
          "type": "object",
          "required": [
            "unitTestPercentage",
            "integrationTestPercentage",
            "e2eTestPercentage",
            "unitTestsExecuteIo",
            "businessLogicCoverage",
            "domainCoverage",
            "applicationCoverage",
            "infrastructureCoverage",
            "apiCoverage",
            "unitTestsHaveIoOperations"
          ],
          "properties": {
            "unitTestPercentage": {
              "type": "number"
            },
            "integrationTestPercentage": {
              "type": "number"
            },
            "e2eTestPercentage": {
              "type": "number"
            },
            "unitTestsExecuteIo": {
              "type": "boolean"
            },
            "businessLogicCoverage": {
              "type": "number"
            },
            "domainCoverage": {
              "type": "number"
            },
            "applicationCoverage": {
              "type": "number"
            },
            "infrastructureCoverage": {
              "type": "number"
            },
            "apiCoverage": {
              "type": "number"
            },
            "unitTestsHaveIoOperations": {
              "type": "boolean"
            },
            "integrationUsesEphemeralContainers": {
              "type": "boolean",
              "description": "Read by testing-pyramid.rego. Declared by GT-695."
            },
            "e2eCoversHttpRoutes": {
              "type": "boolean",
              "description": "Read by testing-pyramid.rego. Declared by GT-695."
            }
          }
        }
      }
    }
  }
}
