{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/opa/cli-readiness.input.schema.json",
  "title": "CLI Readiness OPA Policy Input Schema",
  "type": "object",
  "required": ["core"],
  "properties": {
    "core": {
      "type": "object",
      "required": ["cli", "hasPackageLock", "evidence"],
      "properties": {
        "hasPackageLock": { "type": "boolean" },
        "evidence": { "type": "object" },
        "cli": {
          "type": "object",
          "required": ["hasMainJs", "hasTests", "hasPackageLock", "hasReadme", "hasArchitectureMd"],
          "properties": {
            "hasMainJs": { "type": "boolean" },
            "hasTests": { "type": "boolean" },
            "hasPackageLock": { "type": "boolean" },
            "hasReadme": { "type": "boolean" },
            "hasArchitectureMd": { "type": "boolean" }
          }
        }
      }
    }
  }
}
