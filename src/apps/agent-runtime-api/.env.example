# ─── Deployment profile (GT-438) ─────────────────────────────────────────────
# ONE switch governs the whole adapter set:
#   dev (default; also development/local/test)
#       Deterministic stubs + in-memory state are the explicit default. The
#       runtime boots offline with no live Core, no engine and no volume. Each
#       real adapter is still opt-in per env var below.
#   production
#       The real adapters are MANDATORY — the service FAILS TO BOOT (loud error)
#       instead of silently degrading to a stub. Under this profile:
#         · AGENT_RUNTIME_CORE_ENDPOINT + AGENT_RUNTIME_CORE_TOKEN are required
#           (real authenticated Core; no StubCoreEvaluationAdapter fallback).
#         · AGENT_RUNTIME_STATE_DIR is required (durable memory + scheduler
#           state on a mounted volume; no volatile in-memory fallback).
#         · Real OPA is enforced (an explicit stub policy request is refused).
#       The reasoning engine stays GT-385-gated: an unset AGENT_RUNTIME_ENGINE
#       keeps the deterministic stub engine in every profile.
# Setting a real adapter's env var always graduates that one port regardless of
# profile (e.g. the endpoint-driven local-kind wiring works under dev).
AGENT_RUNTIME_PROFILE=dev

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# CORS: in development '*' is automatic. In production, set explicit origins (CSV)
# or leave empty to deny cross-origin. Example:
# CORS_ORIGINS=https://tracker.beyondnet.cloud
CORS_ORIGINS=

# ─── Authentication (REQUIRED in production) ─────────────────────────────────
# Two credential types are accepted (GT-439):
#   1. Shared API key — callers send `x-api-key: <key>` or
#      `Authorization: Bearer <key>`. Service-level: acts across tenants.
#   2. Tenant JWT — callers send `Authorization: Bearer <jwt>`, HS256-verified
#      against AGENT_RUNTIME_JWT_SECRET. The verified `tenant` claim scopes the
#      principal and TenantCorpusGuard enforces per-tenant corpus isolation.
# Fail-closed: in production, if NEITHER is set, all non-public routes are denied
# unless AGENT_RUNTIME_ALLOW_NO_AUTH=true. /health, /metrics and / are public.
# NOTE: the live multi-tenant JWT issuer (JWKS/asymmetric) is gated infra; the
# HS256 shared-secret path here is the verifiable slice.
AGENT_RUNTIME_API_KEY=
AGENT_RUNTIME_JWT_SECRET=
AGENT_RUNTIME_ALLOW_NO_AUTH=false

# ─── .harness executor (optional) ────────────────────────────────────────────
# When set, the runtime executes real .harness capabilities via the process
# adapter instead of the in-memory stub. Point it at the mounted corpus.
# AGENT_RUNTIME_HARNESS_ROOT=/app/corpus/.harness
AGENT_RUNTIME_HARNESS_ROOT=
AGENT_RUNTIME_WORKSPACE_ROOT=/app/corpus

# ─── Workspace context assembly (optional; GT-438) ───────────────────────────
# When set, the runtime assembles the REAL workspace from this mounted corpus and
# passes it INLINE to the stateless Core (`evaluationInput.files`), so the Core
# governs actual content instead of an empty context (which yields GOV-000
# "nothing to evaluate" findings). Unset ⇒ the prior workspaceRef-only flow. If
# only AGENT_RUNTIME_WORKSPACE_ROOT is set, it is reused as the corpus root.
# AGENT_RUNTIME_WORKSPACE_CONTEXT_ROOT=/app/corpus
AGENT_RUNTIME_WORKSPACE_CONTEXT_ROOT=

# ─── OPA policy (optional) ───────────────────────────────────────────────────
# Enable to validate via the bundled OPA binary instead of the stub.
AGENT_RUNTIME_OPA_ENABLED=false
# AGENT_RUNTIME_OPA_PATH=/app/corpus/.harness/bin/opa
# AGENT_RUNTIME_OPA_POLICY_DIR=/app/corpus/rulesets/opa
AGENT_RUNTIME_OPA_PATH=
AGENT_RUNTIME_OPA_POLICY_DIR=

# ─── Core evaluation (REQUIRED in production) ────────────────────────────────
# The real stateless Core over HTTP (Core API /api/v1/evaluate). When set, the
# runtime governs over the REAL Core instead of the deterministic stub. In the
# production profile BOTH are mandatory (fail-loud).
# AGENT_RUNTIME_CORE_ENDPOINT=https://core.beyondnet.cloud/api/v1/evaluate
AGENT_RUNTIME_CORE_ENDPOINT=
AGENT_RUNTIME_CORE_TOKEN=

# ─── Reasoning engine (optional; GT-385-gated) ───────────────────────────────
# Selects the IAgentEnginePort adapter. Unset (or 'stub') keeps the
# deterministic stub engine in every profile. 'routing' additionally requires
# AGENT_RUNTIME_ENGINE_ROUTER (a JSON EngineRouterConfig).
#   one of: stub | hermes | swarms | cowork | routing
# AGENT_RUNTIME_ENGINE=hermes
AGENT_RUNTIME_ENGINE=
# AGENT_RUNTIME_ENGINE_ROUTER={"defaultEngine":"stub","routes":[{"intentMatches":"deploy","engine":"hermes"}]}
AGENT_RUNTIME_ENGINE_ROUTER=

# ─── Durable state (REQUIRED in production) ──────────────────────────────────
# Mounted volume that persists the runtime's working memory across restarts
# (FileMemoryAdapter) and backs the durable FileSchedulerAdapter driven by the
# host scheduling loop. Required (fail-loud) under the production profile.
# AGENT_RUNTIME_STATE_DIR=/var/lib/evolith-runtime
AGENT_RUNTIME_STATE_DIR=

# ─── Tracker trazability (optional) ──────────────────────────────────────────
# When set, trace events are POSTed to a live Evolith Tracker.
# AGENT_RUNTIME_TRACKER_ENDPOINT=https://tracker.beyondnet.cloud/api/v1/traces
AGENT_RUNTIME_TRACKER_ENDPOINT=
AGENT_RUNTIME_TRACKER_TOKEN=
