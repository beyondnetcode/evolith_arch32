# Copy to .env and `set -a; source .env; set +a` before running the harness.
# These are the ONLY knobs the k6 + chaos scripts need to point at a target.

# ─── Target ──────────────────────────────────────────────────────────────────
# core-api base URL. Local full-stack compose maps core-api 3001->3000.
# For a future prod/staging target, set the real origin (blocked on GT-448).
BASE_URL=http://localhost:3001

# API key for POST /api/v1/evaluate (core-api ApiKeyGuard; header x-api-key).
# Matches EVOLITH_API_KEY used to bring the stack up.
EVOLITH_API_KEY=local-dev-key

# ─── SLO overrides (defaults live in k6/lib/config.js) ───────────────────────
# SLO_HEALTH_P95=150
# SLO_HEALTH_P99=300
# SLO_EVALUATE_P95=800
# SLO_EVALUATE_P99=1500
# SLO_ERROR_RATE=0.01

# ─── Chaos knobs (defaults live in chaos/lib/common.sh) ──────────────────────
# COMPOSE_FILE=../docker-compose.fullstack.yml
# CORE_HEALTH_URL=http://localhost:3001/health
# BROKER_SERVICE=redis
# RUNS=3
# RECOVERY_TIMEOUT=240
