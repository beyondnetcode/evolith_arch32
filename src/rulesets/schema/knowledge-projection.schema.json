{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/knowledge-projection.schema.json",
  "title": "Approved Knowledge Projection",
  "description": "Explicit projection of KI-* candidates approved for RAG retrieval.",
  "type": "object",
  "required": ["projection_version", "approved_knowledge_ids", "generated_at"],
  "properties": {
    "projection_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "approved_knowledge_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^KI-[A-Z0-9-]+$" },
      "uniqueItems": true
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
