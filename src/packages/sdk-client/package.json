{
  "name": "@beyondnet/evolith-sdk",
  "version": "2.0.0",
  "description": "Typed client library for the Evolith Core REST API and MCP tools",
  "keywords": [
    "evolith",
    "architecture-governance",
    "policy-as-code",
    "sdk",
    "rest-client",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "generate": "echo 'No codegen: payload types are re-exported from @beyondnet/evolith-core-domain; only envelopes and request DTOs are authored here'",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@beyondnet/evolith-agent-runtime": "^1.1.0",
    "@beyondnet/evolith-core-domain": "^1.1.0"
  },
  "homepage": "https://github.com/beyondnetcode/evolith_arch32#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beyondnetcode/evolith_arch32.git",
    "directory": "src/packages/sdk-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
