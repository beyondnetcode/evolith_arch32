{
  "name": "evolith",
  "version": "0.0.1",
  "private": true,
  "description": "Evolith Architecture Reference - Monorepo root",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -b tsconfig.json",
    "build:clean": "tsc -b tsconfig.json --clean",
    "build:force": "tsc -b tsconfig.json --force",
    "build:policy": "node ./.harness/scripts/compile-opa-wasm.mjs",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config src/tests/contract/jest.config.js --runInBand --no-bail",
    "test:exploration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config src/tests/exploration/jest.config.js --runInBand --no-bail"
  },
  "workspaces": [
    "src/sdk/*",
    "src/apps/*",
    "src/packages/*"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "20.5.3",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "pg": "8.16.3"
  },
  "overrides": {
    "multer": "2.2.0",
    "js-yaml": "4.3.1",
    "brace-expansion": "5.0.9",
    "protobufjs": "7.6.5",
    "micromatch": "4.0.8",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "fast-uri": "3.1.7",
    "browserslist": "4.28.9",
    "eslint": {
      "ajv": "^6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "ip-address": "10.4.0",
    "hono": "4.12.34"
  }
}
