{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evolith.dev/schema/topology-manifest.schema.json",
  "title": "Evolith Topology Manifest",
  "description": "JSON Schema for validating topology.manifest.json files in the Multi-Topology Reference Corpus. The manifest is technical-only and exposes topology context for CLI, MCP, and Service CORE API resolution.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec", "businessBoundary"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "evolith.dev/topology/v1",
      "description": "Topology manifest API version."
    },
    "kind": {
      "type": "string",
      "const": "TopologyManifest",
      "description": "Manifest kind."
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "dimension", "status", "version", "governance"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable topology identifier in kebab-case, for example modular-monolith, serverless, data-mesh, or agentic-ai."
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "description": "Human-readable topology name."
        },
        "dimension": {
          "type": "string",
          "enum": ["progressive-axis", "execution", "integration", "data", "ai"],
          "description": "Dimensional family for this topology profile."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "proposed", "accepted", "deprecated"],
          "description": "Governance status of the topology profile."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the topology manifest contract instance."
        },
        "governance": {
          "type": "object",
          "required": ["owner", "criticality"],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 3,
              "description": "Organizational unit accountable for this topology (e.g. Architecture Board, Platform Engineering)."
            },
            "criticality": {
              "type": "string",
              "enum": ["P0", "P1", "P2"],
              "description": "Business criticality tier: P0 = critical, P1 = high, P2 = medium."
            },
            "supersedes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^ADR-\\d{4}$" },
              "uniqueItems": true,
              "description": "ADR IDs that this topology supersedes (optional)."
            },
            "replaces": {
              "type": "array",
              "items": { "type": "string", "pattern": "^ADR-\\d{4}$" },
              "uniqueItems": true,
              "description": "ADR IDs replaced by this topology (optional)."
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "summary",
        "topologyType",
        "compatibility",
        "artifacts",
        "operationalInterfaces"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "Technical purpose and applicability of the topology."
        },
        "topologyType": {
          "type": "string",
          "enum": [
            "modular-monolith",
            "distributed-modules",
            "microservices",
            "serverless",
            "edge-computing",
            "event-driven",
            "data-mesh",
            "agentic-ai"
          ],
          "description": "Canonical topology archetype governed by this manifest."
        },
        "compatibility": {
          "type": "object",
          "required": ["progressiveAxis", "composableWith"],
          "additionalProperties": false,
          "properties": {
            "progressiveAxis": {
              "type": "object",
              "required": ["maturityLevel", "profile"],
              "additionalProperties": false,
              "properties": {
                "maturityLevel": {
                  "type": "string",
                  "enum": ["F1", "F2", "F3", "cross"],
                  "description": "GT-343: architecture maturity level on the progressive axis — NOT an SDLC phase. F1/F2/F3 are legacy maturity ordinals (canonical topology id is in `profile`); use cross for topologies composable across multiple levels."
                },
                "profile": {
                  "type": "string",
                  "enum": ["modular-monolith", "distributed-modules", "microservices", "cross"],
                  "description": "Canonical topology id for the progressive-axis model (the authoritative identifier)."
                }
              }
            },
            "composableWith": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "uniqueItems": true,
              "description": "Topology identifiers that can be combined with this manifest."
            }
          }
        },
        "artifacts": {
          "type": "object",
          "required": ["adrs", "rulesets", "opaPolicies", "aiRulesets", "umsContracts"],
          "additionalProperties": false,
          "properties": {
            "adrs": {
              "type": "array",
              "items": { "$ref": "#/definitions/repositoryPath" },
              "uniqueItems": true,
              "description": "Accepted or draft ADRs governing this topology."
            },
            "rulesets": {
              "type": "array",
              "items": { "$ref": "#/definitions/repositoryPath" },
              "uniqueItems": true,
              "description": "Native machine-readable rulesets for this topology."
            },
            "opaPolicies": {
              "type": "array",
              "items": { "$ref": "#/definitions/repositoryPath" },
              "uniqueItems": true,
              "description": "OPA/Rego policies for this topology."
            },
            "aiRulesets": {
              "type": "array",
              "items": { "$ref": "#/definitions/repositoryPath" },
              "uniqueItems": true,
              "description": "AI-consumable rulesets and context artifacts for this topology."
            },
            "umsContracts": {
              "type": "array",
              "items": { "$ref": "#/definitions/repositoryPath" },
              "uniqueItems": true,
              "description": "Technical UMS contract references related to this topology."
            }
          }
        },
        "corpus": {
          "type": "object",
          "description": "Explicit inventory of the topology maturity corpus required by R-27. Required when the topology is accepted.",
          "required": ["guidance", "configurationContract", "fixtures", "nativeEvaluator", "tests", "evidence"],
          "additionalProperties": false,
          "properties": {
            "guidance": {
              "type": "object",
              "required": ["profile", "maturityGuide"],
              "additionalProperties": false,
              "properties": {
                "profile": { "$ref": "#/definitions/repositoryPath" },
                "maturityGuide": { "$ref": "#/definitions/repositoryPath" }
              }
            },
            "configurationContract": { "$ref": "#/definitions/repositoryPath" },
            "fixtures": {
              "type": "object",
              "required": ["valid", "invalid"],
              "additionalProperties": false,
              "properties": {
                "valid": { "$ref": "#/definitions/repositoryPath" },
                "invalid": { "$ref": "#/definitions/repositoryPath" }
              }
            },
            "nativeEvaluator": { "$ref": "#/definitions/repositoryPath" },
            "tests": {
              "type": "object",
              "required": ["positive", "negative"],
              "additionalProperties": false,
              "properties": {
                "positive": { "$ref": "#/definitions/repositoryPath" },
                "negative": { "$ref": "#/definitions/repositoryPath" }
              }
            },
            "evidence": { "$ref": "#/definitions/repositoryPath" }
          }
        },
        "operationalBudgets": {
          "type": "object",
          "description": "Architectural envelopes for execution-tier and AI-tier topologies (GT-165 / GT-219 / ADR-0095 / ADR-0096). These are technical ceilings used by operators to verify the topology's viability, not financial plans — Tracker still owns roi/cost/budget decisions per businessBoundary.",
          "additionalProperties": false,
          "properties": {
            "latencyBudgetMs": {
              "type": "integer",
              "minimum": 1,
              "description": "p99 end-to-end execution budget in milliseconds. The topology is considered non-viable above this ceiling."
            },
            "coldStartCeilingMs": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum acceptable cold-start latency in milliseconds before the topology choice must be revisited."
            },
            "costCeilingPerExecutionCents": {
              "type": "integer",
              "minimum": 1,
              "description": "Architectural ceiling for cost per execution in whole cents. Above this envelope the topology's economics fail; financial planning still lives in Tracker."
            },
            "tokenBudgetPerExecution": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum tokens consumed per AI execution. Above this ceiling the agentic topology is non-viable."
            },
            "credentialRotationIntervalHours": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum hours between credential rotations for agentic AI topologies."
            },
            "sandboxTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum milliseconds an agentic sandbox execution may run before forced termination."
            }
          }
        },
        "designProfile": {
          "type": "object",
          "description": "Design-phase artifact profile (ADR-0104, GT-427). Design-artifact blocks this topology REQUIRES / CONDITIONALLY recommends. The design evaluator derives a blueprint's expected artifacts as the UNION of the designProfiles of the confirmed topology composition (universal blocks always included). Advisory — feeds the maturity score; blocking is the tenant's gate decision.",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "array", "items": { "$ref": "#/definitions/designArtifactDescriptor" } },
            "conditional": { "type": "array", "items": { "$ref": "#/definitions/designArtifactDescriptor" } }
          }
        },
        "phaseProfiles": {
          "type": "object",
          "description": "Downstream-phase artifact profiles (ADR-0104 / DN-06). Per SDLC phase (construction/quality/deployment), the topology-derived artifacts this topology adds. Universal artifacts are applied by the phase evaluator regardless of topology. Structure mirrors spec.designProfile; unioned over the confirmed composition; advisory/non-binding.",
          "additionalProperties": false,
          "properties": {
            "construction": { "$ref": "#/definitions/phaseArtifactProfile" },
            "quality": { "$ref": "#/definitions/phaseArtifactProfile" },
            "deployment": { "$ref": "#/definitions/phaseArtifactProfile" }
          }
        },
        "operationalInterfaces": {
          "type": "object",
          "required": ["cli", "mcp", "coreApi"],
          "additionalProperties": false,
          "properties": {
            "cli": {
              "type": "object",
              "required": ["validators"],
              "additionalProperties": false,
              "properties": {
                "validators": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/kebabIdentifier" },
                  "uniqueItems": true,
                  "description": "CLI validators that can resolve this topology."
                }
              }
            },
            "mcp": {
              "type": "object",
              "required": ["resources", "tools", "prompts"],
              "additionalProperties": false,
              "properties": {
                "resources": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/mcpUri" },
                  "uniqueItems": true
                },
                "tools": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/kebabIdentifier" },
                  "uniqueItems": true
                },
                "prompts": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/kebabIdentifier" },
                  "uniqueItems": true
                }
              }
            },
            "coreApi": {
              "type": "object",
              "required": ["endpoints"],
              "additionalProperties": false,
              "properties": {
                "endpoints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(GET|POST) /[a-z0-9/:{}-]+$"
                  },
                  "uniqueItems": true,
                  "description": "Service CORE API read or validation endpoints that expose this topology."
                }
              }
            }
          }
        }
      }
    },
    "businessBoundary": {
      "type": "object",
      "required": ["technicalOnly", "trackerOwns"],
      "additionalProperties": false,
      "properties": {
        "technicalOnly": {
          "type": "boolean",
          "const": true,
          "description": "Topology manifests are Phase 1 technical ideation artifacts and must not contain business data."
        },
        "trackerOwns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["timing", "ownership", "prioritization", "roi", "cost", "budget", "funnel-0"]
          },
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7,
          "description": "Business concerns reserved for Evolith Tracker via ACL and Funnel 0."
        }
      }
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^(src/)?(reference|rulesets|packages|sdk|apps|product)/[A-Za-z0-9._/-]+$",
      "description": "Repository-relative path without leading slash. The optional src/ prefix reflects the src/ refactor, which moved rulesets, packages, sdk and apps under src/ while reference/ stayed at the root; these paths are resolved by joining against the repository root (GT-563)."
    },
    "kebabIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "phaseArtifactProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required/conditional artifact descriptors for one downstream SDLC phase (DN-06).",
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/definitions/designArtifactDescriptor" } },
        "conditional": { "type": "array", "items": { "$ref": "#/definitions/designArtifactDescriptor" } }
      }
    },
    "designArtifactDescriptor": {
      "type": "object",
      "required": ["artifactKind"],
      "additionalProperties": false,
      "description": "One design-artifact block a topology expects (ADR-0104). `artifactKind` is open under Convention over Configuration — new block kinds are added without changing this schema.",
      "properties": {
        "artifactKind": { "$ref": "#/definitions/kebabIdentifier" },
        "schemaRef": { "type": "string", "description": "Path to the block's JSON schema (added in GT-428/F3)." },
        "templateRef": { "type": "string", "description": "Path to the block's authoring template." },
        "criteria": { "type": "string", "description": "What a mature block demonstrates (human-readable acceptance criterion)." },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "Relative weight in this topology's maturity contribution." },
        "condition": { "type": "string", "description": "For conditional blocks: when it applies, e.g. 'composed-with:event-driven' or 'f3-planned'." }
      }
    },
    "mcpUri": {
      "type": "string",
      "pattern": "^evolith://[a-z0-9/{}/:-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "spec": { "required": ["corpus"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          },
          "spec": {
            "properties": {
              "topologyType": { "enum": ["serverless", "edge-computing"] }
            },
            "required": ["topologyType"]
          }
        }
      },
      "then": {
        "properties": {
          "spec": { "required": ["operationalBudgets"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": { "status": { "const": "accepted" } },
            "required": ["status"]
          },
          "spec": {
            "properties": {
              "topologyType": { "const": "agentic-ai" }
            },
            "required": ["topologyType"]
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "required": ["operationalBudgets"],
            "properties": {
              "operationalBudgets": {
                "required": ["tokenBudgetPerExecution", "credentialRotationIntervalHours", "sandboxTimeoutMs"]
              }
            }
          }
        }
      }
    }
  ]
}
