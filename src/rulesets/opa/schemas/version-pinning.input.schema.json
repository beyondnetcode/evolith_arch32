{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/version-pinning.input.schema.json",
  "title": "Version Pinning OPA Policy Input Schema",
  "type": "object",
  "required": [
    "satellite"
  ],
  "properties": {
    "satellite": {
      "type": "object",
      "required": [
        "packageJson",
        "workspacePackageJsons"
      ],
      "properties": {
        "packageJson": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "devDependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "overrides": {
              "type": "object",
              "description": "Read by version-pinning.rego. Declared by GT-695."
            }
          }
        },
        "workspacePackageJsons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "object",
                "properties": {
                  "dependencies": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "devDependencies": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "overridesRationaleDocumented": {
          "type": "boolean",
          "description": "Read by version-pinning.rego. Declared by GT-695."
        }
      }
    }
  }
}
