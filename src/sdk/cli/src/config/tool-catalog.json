{
  "_comment": "Evolith Tool Catalog per Phase - Extensible, runtime-aware",
  "catalogVersion": "1.0.0",
  "lastUpdated": "2026-06-06",
  "phases": {
    "phase-0": {
      "description": "Foundation - Repository initialized",
      "gateChecks": [
        "evolith.yaml exists",
        "coreRef.version pinned"
      ],
      "artifacts": [
        "evolith.yaml",
        "README.md",
        "evolith-product-vision-master.md"
      ]
    },
    "phase-1": {
      "description": "Structure - Project scaffolded",
      "gateChecks": [
        "package.json exists",
        "src/ directory exists",
        "bilingual README"
      ],
      "artifacts": [
        "package.json",
        "src/",
        "README.es.md"
      ],
      "toolGroups": {
        "runtime": {
          "question": "Which runtime will you use?",
          "defaultOption": "nodejs",
          "optionsFromCatalog": true,
          "toolMapping": {
            "nodejs": [
              "tsc",
              "jest",
              "eslint",
              "prettier"
            ],
            "typescript": [
              "tsc",
              "jest",
              "eslint",
              "prettier"
            ],
            "dotnet": [
              "dotnet CLI",
              "xUnit",
              "dotnet-format"
            ],
            "python": [
              "pytest",
              "black",
              "ruff",
              "mypy"
            ]
          }
        },
        "monorepo": {
          "question": "Monorepo? (Convention: None for small projects)",
          "defaultOption": "none",
          "optionsFromCatalog": true,
          "toolMapping": {
            "nx": [
              "nx",
              "@nx/js",
              "@nx/node"
            ],
            "npm-workspaces": [
              "npm"
            ],
            "pnpm-workspaces": [
              "pnpm"
            ],
            "rush": [
              "@microsoft/rush"
            ],
            "none": []
          }
        },
        "architecture": {
          "question": "Architecture pattern?",
          "defaultOption": "clean",
          "optionsFromCatalog": true,
          "scaffoldCommands": {
            "clean": "evolith scaffold --pattern=clean",
            "hexagonal": "evolith scaffold --pattern=hexagonal",
            "ddd": "evolith scaffold --pattern=ddd",
            "event-driven": "evolith scaffold --pattern=event-driven"
          }
        },
        "database": {
          "question": "Database?",
          "defaultOption": "postgresql",
          "optionsFromCatalog": true,
          "toolMapping": {
            "postgresql": [
              "typeorm",
              "pg",
              "ef-core",
              "sqlalchemy"
            ],
            "mongodb": [
              "mongoose",
              "mongodb-driver",
              "mongo"
            ],
            "sqlserver": [
              "ef-core",
              "mssql"
            ],
            "sqlite": [
              "better-sqlite3",
              "ef-core"
            ]
          }
        },
        "apiProtocol": {
          "question": "API protocol?",
          "defaultOption": "rest",
          "optionsFromCatalog": true,
          "toolMapping": {
            "rest": [
              "swagger",
              "openapi"
            ],
            "graphql": [
              "apollo",
              "graphql"
            ],
            "grpc": [
              "grpc-tools",
              "protobuf"
            ]
          }
        }
      },
      "defaultTools": {
        "nodejs": [
          "typescript",
          "jest",
          "eslint",
          "prettier",
          "husky"
        ],
        "typescript": [
          "typescript",
          "jest",
          "eslint",
          "prettier",
          "husky"
        ],
        "dotnet": [
          ".NET SDK",
          "xUnit",
          "dotnet-format"
        ],
        "python": [
          "pytest",
          "black",
          "ruff",
          "mypy"
        ]
      }
    },
    "phase-2": {
      "description": "Governance - Rulesets and ACL configured",
      "gateChecks": [
        "rulesets/ exists",
        "ACL rules present",
        ".harness/ exists"
      ],
      "artifacts": [
        "rulesets/",
        ".harness/",
        "acl/"
      ],
      "toolGroups": {
        "acl": {
          "question": "ACL validation?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "Anti-Corruption Layer with schema validation"
            },
            {
              "value": "minimal",
              "label": "Minimal",
              "description": "Transformation logging only"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without ACL validation"
            }
          ],
          "tools": [
            "acl-schema-validator",
            "transformation-logger"
          ]
        },
        "adr": {
          "question": "ADR system?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "Full ADR system with matrix and templates"
            },
            {
              "value": "minimal",
              "label": "Minimal",
              "description": "Registry only, no template"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without ADRs"
            }
          ],
          "tools": [
            "adr-create",
            "adr-matrix",
            "adr-template"
          ]
        },
        "hooks": {
          "question": "Git hooks?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes (Husky)",
              "description": "Pre-commit with Evolith validation"
            },
            {
              "value": "lefthook",
              "label": "Lefthook",
              "description": "Alternativa multiplataforma"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without hooks"
            }
          ],
          "tools": [
            "husky",
            "lefthook"
          ]
        },
        "bilingual": {
          "question": "Bilingual documentation?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "EN + ES across all documentation"
            },
            {
              "value": "es-only",
              "label": "ES only",
              "description": "Spanish only"
            },
            {
              "value": "no",
              "label": "No",
              "description": "English only"
            }
          ],
          "tools": [
            "check-bilingual-parity",
            "bilingual-coverage"
          ]
        }
      },
      "defaultTools": [
        "acl-schema-validator",
        "adr-registry",
        "husky",
        "validate-docs",
        "check-bilingual-parity"
      ]
    },
    "phase-3": {
      "description": "Architecture - ADRs and Bounded Contexts defined",
      "gateChecks": [
        "ADR exists",
        "ADR matrix updated",
        "Bounded context map defined"
      ],
      "artifacts": [
        "reference/core/architecture/adrs/",
        "bounded-context-map.json"
      ],
      "toolGroups": {
        "contextMapping": {
          "question": "Context mapping?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "Full bounded context map"
            },
            {
              "value": "minimal",
              "label": "Minimal",
              "description": "Context list only"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without context mapping"
            }
          ],
          "tools": [
            "context-mapper",
            "context-map-renderer"
          ]
        },
        "adrCreation": {
          "question": "ADR creation?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "ADR templates and commands"
            },
            {
              "value": "manual",
              "label": "Manual",
              "description": "Templates only, no commands"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without ADR tooling"
            }
          ],
          "tools": [
            "adr-create",
            "adr-template"
          ]
        },
        "contracts": {
          "question": "Contracts registry?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "Documented inter-context contracts"
            },
            {
              "value": "openapi",
              "label": "OpenAPI only",
              "description": "Contracts via OpenAPI spec"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without a contract registry"
            }
          ],
          "tools": [
            "contract-registry",
            "openapi-generator"
          ]
        },
        "events": {
          "question": "Event schemas?",
          "defaultOption": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes",
              "description": "Full event schema registry"
            },
            {
              "value": "kafka",
              "label": "Kafka Schema Registry",
              "description": "Confluent Schema Registry"
            },
            {
              "value": "no",
              "label": "No",
              "description": "Continue without event schemas"
            }
          ],
          "tools": [
            "event-schema-registry",
            "schema-validator"
          ]
        },
        "patterns": {
          "question": "Additional patterns?",
          "defaultOption": "none",
          "options": [
            {
              "value": "none",
              "label": "None",
              "description": "No additional patterns"
            },
            {
              "value": "event-sourcing",
              "label": "Event Sourcing",
              "description": "Event store for aggregates"
            },
            {
              "value": "cqrs",
              "label": "CQRS",
              "description": "Command Query Separation"
            },
            {
              "value": " saga",
              "label": "Saga/Orchestration",
              "description": "Transacciones distribuidas"
            }
          ],
          "tools": [
            "event-store",
            "cqrs-projections",
            "saga-orchestrator"
          ]
        }
      },
      "defaultTools": [
        "context-mapper",
        "adr-create",
        "contract-registry",
        "event-schema-registry"
      ]
    },
    "phase-4": {
      "description": "Production - Container, CI/CD, Observability",
      "gateChecks": [
        "Dockerfile exists",
        "CI/CD configured",
        "DORA metrics"
      ],
      "artifacts": [
        "Dockerfile",
        ".github/workflows/",
        "observability.config.json"
      ],
      "toolGroups": {
        "container": {
          "question": "Container?",
          "defaultOption": "docker",
          "options": [
            {
              "value": "docker",
              "label": "Docker",
              "description": "Dockerfile + Docker Compose"
            },
            {
              "value": "docker-kaniko",
              "label": "Docker + Kaniko",
              "description": "Build without a Docker daemon"
            },
            {
              "value": "buildpacks",
              "label": "Cloud Native Buildpacks",
              "description": "Pack for automated builds"
            },
            {
              "value": "none",
              "label": "No",
              "description": "Continue without a container"
            }
          ],
          "tools": [
            "dockerfile-generator",
            "docker-compose-dev"
          ]
        },
        "cicd": {
          "question": "CI/CD?",
          "defaultOption": "github-actions",
          "options": [
            {
              "value": "github-actions",
              "label": "GitHub Actions",
              "description": "Workflows en .github/workflows/"
            },
            {
              "value": "gitlab-ci",
              "label": "GitLab CI",
              "description": ".gitlab-ci.yml"
            },
            {
              "value": "azure-pipelines",
              "label": "Azure Pipelines",
              "description": "azure-pipelines.yml"
            },
            {
              "value": "jenkins",
              "label": "Jenkins",
              "description": "Jenkinsfile"
            },
            {
              "value": "none",
              "label": "No",
              "description": "Continue without CI/CD"
            }
          ],
          "tools": [
            "ci-workflow-generator",
            "cd-pipeline"
          ]
        },
        "orchestration": {
          "question": "Orchestration?",
          "defaultOption": "none",
          "options": [
            {
              "value": "none",
              "label": "None (dev/test)",
              "description": "Docker only, no K8s"
            },
            {
              "value": "kubernetes",
              "label": "Kubernetes",
              "description": "Helm + manifests"
            },
            {
              "value": "docker-swarm",
              "label": "Docker Swarm",
              "description": "Stack compose"
            }
          ],
          "tools": [
            "k8s-manifests",
            "helm-chart",
            "ingress-controller"
          ]
        },
        "secrets": {
          "question": "Secrets management?",
          "defaultOption": "env",
          "options": [
            {
              "value": "env",
              "label": "Environment vars",
              "description": "Simple, file-based (.env)"
            },
            {
              "value": "openbao",
              "label": "OpenBao",
              "description": "Dynamic secrets, rotation (Vault fork)"
            },
            {
              "value": "aws-secrets",
              "label": "AWS Secrets Manager",
              "description": "For AWS deployments"
            },
            {
              "value": "azure-keyvault",
              "label": "Azure Key Vault",
              "description": "For Azure deployments"
            }
          ],
          "tools": [
            "secrets-injector",
            "openbao-agent",
            "aws-secrets-sync"
          ]
        }
      },
      "defaultTools": [
        "dockerfile",
        "github-actions",
        "otel-instrumentation",
        "env-secrets"
      ]
    },
    "phase-5": {
      "description": "Observability - DORA metrics, alerting, dashboards",
      "gateChecks": [
        "Metrics collected",
        "Traces instrumented",
        "Logs aggregated"
      ],
      "artifacts": [
        "grafana-dashboard.json",
        "alert-rules.yaml",
        "slo-config.json"
      ],
      "toolGroups": {
        "tracing": {
          "question": "Tracing?",
          "defaultOption": "jaeger",
          "options": [
            {
              "value": "jaeger",
              "label": "Jaeger",
              "description": "OpenTelemetry-compatible tracer"
            },
            {
              "value": "zipkin",
              "label": "Zipkin",
              "description": "Legacy compatible"
            },
            {
              "value": "aws-xray",
              "label": "AWS X-Ray",
              "description": "For AWS"
            },
            {
              "value": "none",
              "label": "No",
              "description": "No distributed tracing"
            }
          ],
          "tools": [
            "jaeger-agent",
            "otel-collector-trace"
          ]
        },
        "metrics": {
          "question": "Metrics?",
          "defaultOption": "prometheus",
          "options": [
            {
              "value": "prometheus",
              "label": "Prometheus",
              "description": "Pull-based metrics"
            },
            {
              "value": "datadog",
              "label": "Datadog",
              "description": "APM + metrics"
            },
            {
              "value": "cloudwatch",
              "label": "CloudWatch",
              "description": "AWS metrics"
            },
            {
              "value": "none",
              "label": "No",
              "description": "No metrics"
            }
          ],
          "tools": [
            "prometheus-server",
            "node-exporter",
            "metrics-adapter"
          ]
        },
        "logs": {
          "question": "Log aggregation?",
          "defaultOption": "loki",
          "options": [
            {
              "value": "loki",
              "label": "Loki",
              "description": "Log aggregation, Prometheus-compatible"
            },
            {
              "value": "elasticsearch",
              "label": "Elasticsearch",
              "description": "ELK stack"
            },
            {
              "value": "cloudwatch-logs",
              "label": "CloudWatch Logs",
              "description": "AWS log aggregation"
            },
            {
              "value": "none",
              "label": "No",
              "description": "No log aggregation"
            }
          ],
          "tools": [
            "loki",
            "promtail",
            "logcli"
          ]
        },
        "visualization": {
          "question": "Dashboards?",
          "defaultOption": "grafana",
          "options": [
            {
              "value": "grafana",
              "label": "Grafana",
              "description": "Dashboards + alerting"
            },
            {
              "value": "datadog-dashboards",
              "label": "Datadog",
              "description": "Dashboards Included"
            },
            {
              "value": "none",
