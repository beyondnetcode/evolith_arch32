{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/hexagonal-architecture.input.schema.json",
  "title": "Hexagonal Architecture OPA Policy Input Schema",
  "type": "object",
  "required": ["satellite"],
  "properties": {
    "satellite": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "layers": {
          "type": "object",
          "required": ["core", "application", "infrastructure", "hasBackwardImports"],
          "properties": {
            "core": {
              "type": "object",
              "required": ["hasFrameworkImports", "hasAopDecorators", "domainTestsRequireBootstrap"],
              "properties": {
                "hasFrameworkImports": { "type": "boolean" },
                "hasAopDecorators": { "type": "boolean" },
                "domainTestsRequireBootstrap": { "type": "boolean" }
              }
            },
            "application": {
              "type": "object",
              "required": ["hasInfrastructureImports", "hasAopDecorators"],
              "properties": {
                "hasInfrastructureImports": { "type": "boolean" },
                "hasAopDecorators": { "type": "boolean" }
              }
            },
            "infrastructure": {
              "type": "object",
              "required": ["implementsPorts"],
              "properties": {
                "implementsPorts": { "type": "boolean" }
              }
            },
            "hasBackwardImports": { "type": "boolean" }
          }
        }
      }
    }
  }
}
