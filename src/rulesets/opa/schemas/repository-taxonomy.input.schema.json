{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evolith.dev/schema/opa/repository-taxonomy.input.schema.json",
  "title": "Repository Taxonomy OPA Policy Input Schema",
  "type": "object",
  "required": ["repository"],
  "properties": {
    "repository": {
      "type": "object",
      "required": ["type", "directories", "adrs"],
      "properties": {
        "type": { "type": "string", "enum": ["core", "satellite"] },
        "directories": { "type": "array", "items": { "type": "string" } },
        "adrs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
