      "opaPolicies": [
        "reference/core/architecture/topologies/data/data-mesh/data-mesh.rego"
      ],
      "aiRulesets": [
        "reference/core/architecture/topologies/data/data-mesh/README.md"
      ],
      "umsContracts": [
        "reference/knowledge/demo/ums-reference-model.md"
      ]
    },
    "corpus": {
      "guidance": {
        "profile": "reference/core/architecture/topologies/data/data-mesh/README.md",
        "maturityGuide": "reference/core/architecture/topologies/data/data-mesh/maturity.md"
      },
      "configurationContract": "reference/core/architecture/topologies/data/data-mesh/topology.config.schema.json",
      "fixtures": {
        "valid": "reference/core/architecture/topologies/data/data-mesh/fixtures/valid.topology.config.json",
        "invalid": "reference/core/architecture/topologies/data/data-mesh/fixtures/invalid.topology.config.json"
      },
      "nativeEvaluator": "packages/core-domain/src/application/validators/ruleset-validator.service.ts",
      "tests": {
        "positive": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts",
        "negative": "packages/core-domain/src/application/validators/ruleset-validator-architecture.spec.ts"
      },
      "evidence": "reference/core/control-center/maturity-evidence.json"
